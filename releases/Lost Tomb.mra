    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin stick</special_controls>
    <num_buttons>6</num_buttons>
    <buttons names="Fire,-,R Right,R Left,Coin,Start 1P,Start 2P,Pause,R Down,R Up,-" default="R,A,Y,Select,Start,,L,B,X"/>

    <switches default="FF,FD,F3">
        <dip name="Lives" bits="8,9" ids="3,5,Free Play,Invulnerability (Cheat)" values="1,2,3,0"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 1/1,A 1/2  B 2/1,A 1/3  B 3/1,A 1/4  B 4/1" values="1,0,2,3"/>
        <dip name="Demo Sounds" bits="19" ids="Off,On" values="1,0"/>
    </switches>

