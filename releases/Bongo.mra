<misterromdescription>
    <name>Bongo</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Bongo</series>
    <year>1983</year>
    <manufacturer>Jetsoft</manufacturer>
    <category>Shooter</category>

    <setname>bongo</setname>
    <parent>bongo</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,42">
        <dip name="Lives" bits="25,26" ids="2,3,4,5"/>
        <dip name="Infinite Lives (Cheat)" bits="27" ids="Off,On"/>
        <dip name="Coinage" bits="30" ids="2C/1C,1C/1C"/>
        <dip name="Cabinet" bits="31" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="bongo.zip">
        <part crc="de9a8ec6" name="bg1.bin"/>
        <part crc="a19da662" name="bg2.bin"/>
        <part crc="9f6f2150" name="bg3.bin"/>
        <part crc="f80372d2" name="bg4.bin"/>
        <part crc="fc92eade" name="bg5.bin"/>
        <part crc="561d9e5d" name="bg6.bin"/>
        <part repeat="0xA000">00</part>
        <part crc="fc79d103" name="b-h.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="94d17bf3" name="b-k.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="c4761ada" name="b-clr.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 00 60 04 06 00 00 00 00 00 00 00 00 00
            11 00 03 04 00 05 00 00 13 14 0B 0C 00 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            07 D4 9E A5 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 83 00 00 11 00 15
            00 00 83 01 00 01 05 05
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="18"></nvram>

    <remark>Bongo (Jetsoft)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
