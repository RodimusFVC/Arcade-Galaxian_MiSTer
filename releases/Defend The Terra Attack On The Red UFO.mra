<misterromdescription>
    <name>Defend The Terra Attack On The Red UFO</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Defend The Terra Attack On The Red UFO</series>
    <year>1981</year>
    <manufacturer>Artic</manufacturer>
    <category>Shooter</category>

    <setname>redufo</setname>
    <parent>redufo</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coin B" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin A" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Bonus Life" bits="16" ids="7000,None"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="redufo.zip">
        <part crc="6a3b873c" name="redufo.1"/>
        <part crc="202eda3b" name="redufo.2"/>
        <part crc="bf7030e8" name="redufo.3"/>
        <part crc="8c1c2ef9" name="redufo.4"/>
        <part crc="ef965b24" name="redufo.5"/>
        <part crc="58b3e39b" name="redufo.6"/>
        <part crc="fd07d811" name="redufo.7"/>
        <part repeat="0xC800">00</part>
        <part crc="b34c7cb4" name="redufo.8"/>
        <part repeat="0x1800">00</part>
        <part crc="50a2d447" name="redufo.9"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="tbp18s030n.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            04 4D 4D AD 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="3"></nvram>

    <remark>Defend The Terra Attack On The Red UFO (Artic)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
