        <part>
            07 90 00 00 FF FC F9 FF FF FF 80 01 02 80 80 80
            00 13 00 14 04 03 12 11 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 00 80 00 02 00 00 00 30 03 00 00 00 00 00 00
            00 00 00 00
        </part>
    </rom>

    <!-- Index 3: Hiscore -->
