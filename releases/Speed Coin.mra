<misterromdescription>
    <name>Speed Coin</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Speed Coin</series>
    <year>1984</year>
    <manufacturer>Stern Electronics</manufacturer>
    <category>Shooter</category>

    <setname>spdcoin</setname>
    <parent>spdcoin</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="-,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="Select,Start,R,L"/>

    <switches default="FF,FC,F9">
        <dip name="Freeze" bits="8" ids="Off,On"/>
        <dip name="Free Play" bits="9" ids="Off,On"/>
        <dip name="Unknown" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="18" ids="Easy,Hard"/>
        <dip name="Lives" bits="19" ids="3,5" values="1,0"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="spdcoin.zip">
        <part crc="65cf1e49" name="spdcoin.2c"/>
        <part crc="1ee59232" name="spdcoin.2e"/>
        <part repeat="0xE000">00</part>
        <part crc="dd5f1dbc" name="spdcoin.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="ab1fe81b" name="spdcoin.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="1a2ccc56" name="spdcoin.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="b4cf64b7" name="spdcoin.5c"/>
        <part crc="92304df0" name="spdcoin.5d"/>
    </rom>

