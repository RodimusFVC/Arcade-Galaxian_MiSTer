<misterromdescription>
    <name>Moonwar</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moonwar</series>
    <year>1981</year>
    <manufacturer>Stern Electronics</manufacturer>
    <category>Shooter</category>

    <setname>moonwar</setname>
    <parent>moonwar</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire,Button 2,Button 3,Button 4,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="E0,FC,F3,FF">
        <dip name="Lives" bits="8,9" ids="3,4,5,Free Play"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 1/1,A 1/2  B 2/1,A 1/3  B 3/1,A 1/4  B 4/1" values="1,0,2,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="moonwar.zip">
        <part crc="7c11b4d9" name="mw2.2c"/>
        <part crc="1b6362be" name="mw2.2e"/>
        <part crc="4fd8ba4b" name="mw2.2f"/>
        <part crc="56879f0d" name="mw2.2h"/>
        <part repeat="0xC000">00</part>
        <part crc="c5fa1aa0" name="moon_war_ii_ra20_5f.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="a6ccc652" name="moon_war_ii_ra20_5h.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="99614c6c" name="moonwar_ii_color_6ea1.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="c26231eb" name="moon_war_ii_ra20_5c.5c"/>
        <part crc="bb48a646" name="moon_war_ii_ra20_5d.5d"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 90 01 00 80 00 02 00 00 00 30 03 00 00 00 00
            00 00 00 00 00 0F 12 11 00 00 13 14 08 07 06 05
            0D 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 04
        </part>
    </rom>

    <remark>Moonwar (Stern Electronics)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
