    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire,Button 2,Button 3,Button 4,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,B,X,Y,Select,Start,R,L"/>

