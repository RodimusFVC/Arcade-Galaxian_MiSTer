<misterromdescription>
    <name>Battle Of Atlantis</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Battle Of Atlantis</series>
    <year>1981</year>
    <manufacturer>Comsoft</manufacturer>
    <category>Shooter</category>

    <setname>atlantis</setname>
    <parent>atlantis</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FE,F1,00">
        <dip name="Cabinet" bits="8" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="9" ids="3,5" values="1,0"/>
        <dip name="Coinage" bits="17,19" ids="A 1/3  B 2/1,A 1/6  B 1/1,A 1/99 B 1/99" values="1,0,2"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="atlantis.zip">
        <part crc="0e485b9a" name="2c"/>
        <part crc="c1640513" name="2e"/>
        <part crc="eec265ee" name="2f"/>
        <part crc="a5d2e442" name="2h"/>
        <part crc="45f7cf34" name="2j"/>
        <part crc="f335b96b" name="2l"/>
        <part repeat="0xD000">00</part>
        <part crc="57f9c6b9" name="5f"/>
        <part repeat="0x1800">00</part>
        <part crc="e989f325" name="5h"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="c01s.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="bcd297f0" name="ot1.5c"/>
        <part crc="de7912da" name="ot2.5d"/>
        <part crc="ba2fa933" name="ot3.5e"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 01 00 00 00 02 00 00 00 30 1B 00 00 00 00
            09 06 00 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 3D 00 2C 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="44"></nvram>

    <remark>Battle Of Atlantis (Set 1) (Comsoft)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
