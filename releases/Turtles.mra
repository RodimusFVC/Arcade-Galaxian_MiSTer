<misterromdescription>
    <name>Turtles</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Turtles</series>
    <year>1981</year>
    <manufacturer>Konami (Stern Electronics license)</manufacturer>
    <category>Shooter</category>

    <setname>turtles</setname>
    <parent>turtles</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,F1,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,126 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1 B 2/1 C 1/1,A 1/2 B 1/1 C 1/2,A 1/3 B 3/1 C 1/3,A 1/4 B 4/1 C 1/4"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="turtles.zip">
        <part crc="ec5e61fb" name="turt_vid.2c"/>
        <part crc="fd10821e" name="turt_vid.2e"/>
        <part crc="ddcfc5fa" name="turt_vid.2f"/>
        <part crc="9e71696c" name="turt_vid.2h"/>
        <part crc="fcd49fef" name="turt_vid.2j"/>
        <part repeat="0xB000">00</part>
        <part crc="e5999d52" name="turt_vid.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="c3ffd655" name="turt_vid.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="f3ef02dd" name="turtles.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="f0c30f9a" name="turt_snd.5c"/>
        <part crc="af5fc43c" name="turt_snd.5d"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            08 91 00 00 80 00 02 00 04 00 80 03 00 00 00 00
            09 00 16 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 3D DE F8 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 82 00 00 1E 00 00
            00 00 80 A8 00 03 00 00
            00 00 93 40 00 01 01 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="34"></nvram>

    <remark>Turtles (Konami (Stern Electronics License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
