<misterromdescription>
    <name>Scorpion</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scorpion</series>
    <year>1982</year>
    <manufacturer>Zaccaria</manufacturer>
    <category>Shooter</category>

    <setname>scorpion</setname>
    <parent>scorpion</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,5B,00,03">
        <dip name="Lives" bits="8,9" ids="3,4,5,255" values="3,2,1,0"/>
        <dip name="Unknown" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="18" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="19" ids="A 1/1  B 1/1,A 1/1  B 1/3" values="1,0"/>
        <dip name="Difficulty" bits="32,33" ids="Normal,Medium,Hard,Very Hard" values="3,2,1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="scorpion.zip">
        <part crc="ba1219b4" name="1.2d"/>
        <part crc="c3909ab6" name="2.2f"/>
        <part crc="43261352" name="3.2g"/>
        <part crc="aba2276a" name="4.2h"/>
        <part repeat="0x1800">00</part>
        <part crc="952f78f2" name="5.2k" offset="0x800" length="0x800"/>
        <part crc="952f78f2" name="5.2k" offset="0x0" length="0x800"/>
        <part repeat="0x9800">00</part>
        <part crc="1e5da9d6" name="igr_scorpion_32_f5.ic72"/>
        <part repeat="0x1000">00</part>
        <part crc="a57adb0a" name="igr_scorpion_32_h5.ic73"/>
        <part repeat="0x1000">00</part>
        <part crc="4e3caeab" name="mmi6331_6e.ic59"/>
        <part repeat="0x3FE0">00</part>
        <part crc="361b8a36" name="igr_scorpion_32_a4.ic12"/>
        <part crc="addecdd4" name="igr_scorpion_32_a5.ic13"/>
        <part repeat="0x6000">00</part>
        <part crc="04abf178" name="igr_scorpion_32_a3.ic25"/>
        <part crc="90352dd4" name="igr_scorpion_32_a2.ic24"/>
        <part crc="3bf2452d" name="igr_scorpion_32_a1.ic23"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 01 00 00 05 02 00 00 00 30 03 00 00 00 00
            09 06 00 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 30 02 31 00 00 00 00 00 00 00 00
            00 00 00 40
