    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,03,FF">
        <dip name="Leave On" bits="18" ids="Off,On" values="1,0"/>
        <dip name="Free Play" bits="19" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="levers.zip">
        <part crc="9550627a" name="g96059.a8"/>
        <part repeat="0x1000">00</part>
        <part crc="5ac64646" name="g96060.d8"/>
        <part crc="9db8e520" name="g96061.e8"/>
        <part repeat="0x4000">00</part>
        <part crc="7c8e8b3a" name="g96062.h8"/>
        <part crc="fa61e793" name="g96063.j8"/>
        <part crc="f797f389" name="g96064.l8"/>
        <part repeat="0x5000">00</part>
        <part crc="d8a0c692" name="g95948.n1"/>
        <part repeat="0x800">00</part>
        <part crc="3660a552" name="g95949.s1"/>
        <part repeat="0x800">00</part>
        <part crc="73b61b2d" name="g95946.j1"/>
        <part repeat="0x800">00</part>
        <part crc="72ff67e2" name="g95947.m1"/>
        <part repeat="0x800">00</part>
        <part crc="01febbbe" name="g960lev.clr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            04 91 01 00 00 07 23 00 00 00 00 00 00 00 00 00
            11 09 03 04 00 00 02 01 13 14 0B 0C 00 12 00 0A
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
