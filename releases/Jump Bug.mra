<misterromdescription>
    <name>Jump Bug</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Jump Bug</series>
    <year>1981</year>
    <manufacturer>Hoei (Rock-Ola license)</manufacturer>
    <category>Shooter</category>

    <setname>jumpbug</setname>
    <parent>jumpbug</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,01,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Difficulty" bits="14" ids="Easy,Hard"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,Infinite (Cheat)" values="1,2,3,0"/>
        <dip name="Coinage" bits="18,19" ids="A 2C/1C  B 2C/1C,A 2C/1C  B 1C/3C,A 1C/1C  B 1C/1C,A 1C/1C  B 1C/6C" values="1,2,0,3"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="jumpbug.zip">
        <part crc="415aa1b7" name="jb1"/>
        <part crc="b1c27510" name="jb2"/>
        <part crc="97c24be2" name="jb3"/>
        <part crc="66751d12" name="jb4"/>
        <part repeat="0x4000">00</part>
        <part crc="e2d66faf" name="jb5"/>
        <part crc="49e0bdfd" name="jb6"/>
        <part crc="83d71302" name="jb7"/>
        <part repeat="0x5800">00</part>
        <part crc="9a091b0a" name="jbl"/>
        <part crc="8a0fc082" name="jbm"/>
        <part crc="155186e0" name="jbn"/>
        <part repeat="0x800">00</part>
        <part crc="7749b111" name="jbi"/>
        <part crc="06e8d7df" name="jbj"/>
        <part crc="b8dbddf3" name="jbk"/>
        <part repeat="0x800">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            04 90 01 00 00 07 23 00 00 00 00 00 00 00 00 00
            11 09 03 04 05 00 02 01 13 14 0B 0C 0D 12 00 0A
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 4A 3E C4 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 22 00 15 00 97
            00 00 42 08 00 06 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="27"></nvram>

    <remark>Jump Bug (Hoei (Rock-Ola License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
