<misterromdescription>
    <name>Ozon I</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Ozon I</series>
    <year>1983</year>
    <manufacturer>Proma</manufacturer>
    <category>Shooter</category>

    <setname>ozon1</setname>
    <parent>ozon1</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,01,FF">
        <dip name="Lives" bits="8,9" ids="3,4,5,6"/>
        <dip name="Coinage" bits="17,18" ids="A 1C/1C  B 2C/1C,A 1C/2C  B 1C/1C,A 1C/3C  B 3C/1C,A 1C/4C  B 4C/1C"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="ozon1.zip">
        <part crc="54899e8b" name="rom1.bin"/>
        <part crc="3c90fbfc" name="rom2.bin"/>
        <part crc="79fe313b" name="rom3.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="464285e8" name="rom7.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="92056dcc" name="rom8.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="605ea6e9" name="ozon1.clr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 00 00 30 00 03 00 00 00 00 00 00 00 00 40
            00 00 00 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 80
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 4A 3E C4 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 47 00 03 00 00
            00 00 43 00 00 4E 01 10
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="81"></nvram>

    <remark>Ozon I (Proma)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
