<misterromdescription>
    <name>Mr. Kougar</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mr. Kougar</series>
    <year>1984</year>
    <manufacturer>ATW</manufacturer>
    <category>Shooter</category>

    <setname>mrkougar</setname>
    <parent>mrkougar</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F1,FF">
        <dip name="Coin B" bits="8" ids="1C/3C,1C/5C"/>
        <dip name="Coin A" bits="9" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Cabinet" bits="17" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Difficulty" bits="19" ids="Hard,Easy"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mrkougar.zip">
        <part crc="fd060ffb" name="2732-7.bin"/>
        <part crc="9e05d868" name="2732-6.bin"/>
        <part crc="cbc7c536" name="2732-5.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="60ef1d43" name="2732-1.bin" offset="0x0" length="0x1000"/>
        <part repeat="0x1000">00</part>
        <part crc="60ef1d43" name="2732-1.bin" offset="0x0" length="0x1000"/>
        <part repeat="0x1000">00</part>
        <part crc="4e3caeab" name="c01s.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="af42a371" name="atw-6w-2.bin"/>
        <part crc="862b8902" name="atw-6y-3.bin"/>
        <part crc="a0396cc8" name="atw-6z-4.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            0F 90 05 00 00 00 02 00 00 00 20 03 00 00 04 0F
            00 00 16 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            01 4E 1A 71 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A6 00 12 00 00
            00 00 4A 61 00 01 10 10
            00 00 4A 41 00 01 10 10
            00 00 4A 21 00 01 10 10
            00 00 4A 01 00 01 10 10
            00 00 49 E1 00 01 10 10
            00 00 49 C1 00 01 10 10
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="24"></nvram>

    <remark>Mr. Kougar (ATW)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
