<misterromdescription>
    <name>Orbitron</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Orbitron</series>
    <year>1982</year>
    <manufacturer>Comsoft (Signatron USA license)</manufacturer>
    <category>Shooter</category>

    <setname>orbitron</setname>
    <parent>orbitron</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,40,00,FF">
        <dip name="Coinage" bits="13,14" ids="A 2C/1C  B 1C/3C,A 2C/1C  B 1C/3C (duplicate),A 1C/1C  B 1C/6C,A 1C/1C  B 1C/6C (duplicate)"/>
        <dip name="Lives" bits="18" ids="2,3" values="1,0"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="orbitron.zip">
        <part crc="419f9c9b" name="orbitron.3" offset="0x600" length="0x200"/>
        <part crc="419f9c9b" name="orbitron.3" offset="0x400" length="0x200"/>
        <part crc="419f9c9b" name="orbitron.3" offset="0x200" length="0x200"/>
        <part crc="419f9c9b" name="orbitron.3" offset="0x0" length="0x200"/>
        <part crc="44ad56ac" name="orbitron.4" offset="0x600" length="0x200"/>
        <part crc="44ad56ac" name="orbitron.4" offset="0x400" length="0x200"/>
        <part crc="44ad56ac" name="orbitron.4" offset="0x200" length="0x200"/>
        <part crc="44ad56ac" name="orbitron.4" offset="0x0" length="0x200"/>
        <part crc="da3f5168" name="orbitron.1" offset="0x600" length="0x200"/>
        <part crc="da3f5168" name="orbitron.1" offset="0x400" length="0x200"/>
        <part crc="da3f5168" name="orbitron.1" offset="0x200" length="0x200"/>
        <part crc="da3f5168" name="orbitron.1" offset="0x0" length="0x200"/>
        <part crc="a3b813fc" name="orbitron.2" offset="0x600" length="0x200"/>
        <part crc="a3b813fc" name="orbitron.2" offset="0x400" length="0x200"/>
        <part crc="a3b813fc" name="orbitron.2" offset="0x200" length="0x200"/>
        <part crc="a3b813fc" name="orbitron.2" offset="0x0" length="0x200"/>
        <part crc="20cd8bb8" name="orbitron.5"/>
        <part repeat="0xD800">00</part>
        <part crc="2c91b83f" name="orbitron.6"/>
        <part repeat="0x1800">00</part>
        <part crc="46f4cca4" name="orbitron.7"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 0A 02 01 13 14 0B 0C 0D 00 00 09
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 4A 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="3"></nvram>

    <remark>Orbitron (Comsoft (Signatron USA License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
