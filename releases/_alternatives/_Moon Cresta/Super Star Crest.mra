<misterromdescription>
    <name>Super Star Crest</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Cresta</series>
    <year>1980?</year>
    <manufacturer>bootleg (Taito do Brasil)</manufacturer>
    <category>Shooter</category>

    <setname>sstarcrs</setname>
    <parent>mooncrst</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="14" ids="30000,50000"/>
        <dip name="Coin A" bits="16,17" ids="4C/1C,3C/1C,2C/1C,1C/1C" values="3,2,1,0"/>
        <dip name="Coin B" bits="18,19" ids="1C/1C,1C/2C,1C/3C,Free Play"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="sstarcrs.zip|mooncrst.zip">
        <part crc="2ff72897" name="ss1"/>
        <part crc="565e7880" name="ss2"/>
        <part crc="a1939def" name="ss3"/>
        <part crc="a332e012" name="ss4"/>
        <part crc="b9e58453" name="ss5"/>
        <part crc="7cbb5bc8" name="ss6"/>
        <part crc="57713b91" name="ss7"/>
        <part crc="c857e898" name="ss8"/>
        <part repeat="0xC000">00</part>
        <part crc="2a95b8ea" name="ss10"/>
        <part crc="b92c4c30" name="ss12" offset="0x0" length="0x200"/>
        <part crc="b92c4c30" name="ss12" offset="0x400" length="0x200"/>
        <part crc="b92c4c30" name="ss12" offset="0x200" length="0x200"/>
        <part crc="b92c4c30" name="ss12" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="3661e084" name="ss9"/>
        <part crc="95613048" name="ss11" offset="0x0" length="0x200"/>
        <part crc="95613048" name="ss11" offset="0x400" length="0x200"/>
        <part crc="95613048" name="ss11" offset="0x200" length="0x200"/>
        <part crc="95613048" name="ss11" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 41 00 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 80 42 00 54 00 24
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="84"></nvram>

    <remark>Super Star Crest (Taito Do Brasil Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
