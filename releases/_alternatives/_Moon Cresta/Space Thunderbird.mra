<misterromdescription>
    <name>Space Thunderbird</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Cresta</series>
    <year>1981?</year>
    <manufacturer>bootleg (Fortrek)</manufacturer>
    <category>Shooter</category>

    <setname>spctbird</setname>
    <parent>mooncrst</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,80,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="14" ids="30000,50000"/>
        <dip name="Language" bits="15" ids="English,Japanese" values="1,0"/>
        <dip name="Coinage" bits="16,17" ids="4C/1C,3C/1C,2C/1C,1C/1C" values="3,2,1,0"/>
        <dip name="Free Play" bits="18,19" ids="Off,On" values="0,3"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="spctbird.zip|mooncrst.zip">
        <part crc="45aab7a3" name="tssa-7f"/>
        <part crc="8b328f48" name="tssa-7h"/>
        <part crc="29a2b0ab" name="tssa-7k"/>
        <part crc="99c9166d" name="tssa-7m"/>
        <part crc="797b6261" name="tssa-5"/>
        <part crc="4825692c" name="tssa-6"/>
        <part crc="b45af1e8" name="tssa-7"/>
        <part crc="c9b77b85" name="tssa-8"/>
        <part repeat="0xC000">00</part>
        <part crc="7d23e1f2" name="tssb-2"/>
        <part crc="e4977833" name="tssb-4" offset="0x0" length="0x200"/>
        <part crc="e4977833" name="tssb-4" offset="0x400" length="0x200"/>
        <part crc="e4977833" name="tssb-4" offset="0x200" length="0x200"/>
        <part crc="e4977833" name="tssb-4" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="9b9267c3" name="tssb-1"/>
        <part crc="5ca5e233" name="tssb-3" offset="0x0" length="0x200"/>
        <part crc="5ca5e233" name="tssb-3" offset="0x400" length="0x200"/>
        <part crc="5ca5e233" name="tssb-3" offset="0x200" length="0x200"/>
        <part crc="5ca5e233" name="tssb-3" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 41 00 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 80 42 00 54 00 24
            00 00 80 4F 00 01 50 50
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="85"></nvram>

    <remark>Space Thunderbird (Fortrek Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
