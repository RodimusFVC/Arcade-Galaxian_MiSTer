        <part repeat="0xC000">00</part>
        <part crc="528da705" name="mc12.bin"/>
        <part crc="5a4b17ea" name="mc14.bin" offset="0x0" length="0x200"/>
        <part crc="5a4b17ea" name="mc14.bin" offset="0x400" length="0x200"/>
        <part crc="5a4b17ea" name="mc14.bin" offset="0x200" length="0x200"/>
        <part crc="5a4b17ea" name="mc14.bin" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="4e79ff6b" name="mc11.bin"/>
        <part crc="e0edccbd" name="mc13.bin" offset="0x0" length="0x200"/>
        <part crc="e0edccbd" name="mc13.bin" offset="0x400" length="0x200"/>
        <part crc="e0edccbd" name="mc13.bin" offset="0x200" length="0x200"/>
        <part crc="e0edccbd" name="mc13.bin" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 41 00 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
