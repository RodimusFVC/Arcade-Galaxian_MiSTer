<misterromdescription>
    <name>Moon Cresta (SNK)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Cresta</series>
    <year>1980</year>
    <manufacturer>Nichibutsu (SNK license)</manufacturer>
    <category>Shooter</category>

    <setname>mooncrsts</setname>
    <parent>mooncrst</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,80,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="14" ids="30000,50000"/>
        <dip name="Language" bits="15" ids="English,Japanese" values="1,0"/>
        <dip name="Coin A" bits="16,17" ids="4C/1C,3C/1C,2C/1C,1C/1C" values="3,2,1,0"/>
        <dip name="Coin B" bits="18,19" ids="1C/1C,1C/2C,1C/3C,Free Play"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mooncrsts.zip|mooncrst.zip">
        <part crc="322859e6" name="mcs1.bin"/>
        <part crc="463de381" name="mcs2.bin"/>
        <part crc="29a2b0ab" name="mcs3.bin"/>
        <part crc="4c6a5a6d" name="mcs4.bin"/>
        <part crc="06d378a6" name="mcs5.bin"/>
        <part crc="6e84a927" name="mcs6.bin"/>
        <part crc="b45af1e8" name="mcs7.bin"/>
        <part crc="699197dd" name="mcs8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="bf14074e" name="mcs_b.bin"/>
        <part crc="13932a15" name="mcs_d.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="2705a395" name="mcs_a.bin"/>
        <part crc="24cfd145" name="mcs_c.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 41 00 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Moon Cresta (SNK) (Nichibutsu (SNK License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
