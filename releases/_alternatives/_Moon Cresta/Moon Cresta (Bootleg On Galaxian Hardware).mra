        <part crc="1e9c168c" name="7"/>
        <part crc="5e09da94" name="8"/>
        <part repeat="0xC000">00</part>
        <part crc="528da705" name="1h_1_10.bin"/>
        <part crc="5a4b17ea" name="12.chr" offset="0x0" length="0x200"/>
        <part crc="5a4b17ea" name="12.chr" offset="0x400" length="0x200"/>
        <part crc="5a4b17ea" name="12.chr" offset="0x200" length="0x200"/>
        <part crc="5a4b17ea" name="12.chr" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="70df525c" name="9.chr"/>
        <part crc="e0edccbd" name="11.chr" offset="0x0" length="0x200"/>
        <part crc="e0edccbd" name="11.chr" offset="0x400" length="0x200"/>
        <part crc="e0edccbd" name="11.chr" offset="0x200" length="0x200"/>
        <part crc="e0edccbd" name="11.chr" offset="0x600" length="0x200"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
