<misterromdescription>
    <name>Tazz-Mania - El Trompa (U.R.V. BBCPE Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tazz-Mania</series>
    <year>1982</year>
    <manufacturer>bootleg (U.R.V. BBCPE)</manufacturer>
    <category>Shooter</category>

    <setname>tazmaniet</setname>
    <parent>tazmania</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,7B,FF">
        <dip name="Lives" bits="8" ids="3,5" values="1,0"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="17,18" ids="1C/1C,Coin A 1/2 Coin B 2/1,Coin A 1/3 Coin B 3/1,Coin A 1/4 Coin B 4/1" values="1,0,2,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="tazmaniet.zip|tazmania.zip">
        <part crc="cea9df87" name="13200.bin"/>
        <part crc="21cfe0b3" name="13201.bin"/>
        <part crc="d204732e" name="13202.bin"/>
        <part crc="5d0651bd" name="13203.bin"/>
        <part crc="9082ac06" name="13204.bin"/>
        <part crc="9c2a08a2" name="13205.bin"/>
        <part repeat="0xA000">00</part>
        <part crc="2c5b612b" name="13206.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="3f5ff3ac" name="13207.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="aa1f7f5e" name="prom.bin"/>
        <part repeat="0x3FE0">00</part>
        <part crc="b8d741f1" name="13208.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            0C 90 01 00 80 00 02 00 00 00 30 03 00 15 00 00
            09 06 00 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
