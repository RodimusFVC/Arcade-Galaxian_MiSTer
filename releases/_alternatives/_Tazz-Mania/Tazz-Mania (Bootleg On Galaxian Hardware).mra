<misterromdescription>
    <name>Tazz-Mania (Bootleg On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Tazz-Mania</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>tazzmang</setname>
    <parent>tazmania</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,00,0C">
        <dip name="Demo Sounds" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="15" ids="3,5"/>
        <dip name="Cabinet" bits="16" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="17,18" ids="A 4C/1C  B 1C/4C,A 3C/1C  B 1C/3C,A 2C/1C  B 1C/2C,1C/1C" values="0,1,3,2"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="tazzmang.zip|tazmania.zip">
        <part crc="a14480a1" name="tazzm1.4k"/>
        <part crc="5609f5db" name="tazzm2.5j"/>
