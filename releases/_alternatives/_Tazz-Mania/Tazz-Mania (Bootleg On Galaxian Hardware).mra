        <part repeat="0xA000">00</part>
        <part crc="2c5b612b" name="tazm8.1lk"/>
        <part repeat="0x1800">00</part>
        <part crc="3f5ff3ac" name="tazzm7.1jh"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="prom.6l"/>
    </rom>

