<misterromdescription>
    <name>Mars (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mars</series>
    <year>1984</year>
    <manufacturer>bootleg (Arfyc)</manufacturer>
    <category>Shooter</category>

    <setname>marsarf</setname>
    <parent>mars</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin joysticks (right stick = fire directions)</special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire Up,Fire Down,Fire Left,Fire Right,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FC,F9,FF">
        <dip name="Coin B" bits="8" ids="1C/3C,1C/5C"/>
        <dip name="Coin A" bits="9" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Cabinet" bits="17" ids="Upright,Cocktail"/>
        <dip name="Unknown" bits="18" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="19" ids="3,255 (Cheat)" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="marsarf.zip|mars.zip">
        <part crc="2fe47b97" name="10041a.ma1"/>
        <part crc="5c37ed57" name="10041a.ma3"/>
