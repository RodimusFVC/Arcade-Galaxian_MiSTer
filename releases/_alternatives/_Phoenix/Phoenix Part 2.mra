            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 89 00 03 00 00
            00 00 51 E1 00 01 20 20
            00 00 51 C1 00 01 20 20
            00 00 51 A1 00 01 20 20
            00 00 51 81 00 01 20 20
            00 00 51 61 00 01 20 20
            00 00 51 41 00 01 20 20
        </part>
    </rom>
    <rom index="4"></rom>
