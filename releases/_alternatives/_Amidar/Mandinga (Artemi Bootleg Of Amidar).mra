<misterromdescription>
    <name>Mandinga (Artemi Bootleg Of Amidar)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Amidar</series>
    <year>1982</year>
    <manufacturer>bootleg (Artemi)</manufacturer>
    <category>Shooter</category>

    <setname>mandinga</setname>
    <parent>amidar</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FE,F1,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)" values="3,2,1,0"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="17" ids="A 1/1 B 1/6,A 2/1 B 1/3"/>
        <dip name="Bonus Life" bits="18" ids="30000 70000,50000 80000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mandinga.zip|amidar.zip">
        <part crc="ac6b2f96" name="1.bin"/>
        <part crc="4c64161e" name="2.bin"/>
        <part crc="2aaccf1a" name="3.bin"/>
        <part crc="29873461" name="4.bin"/>
        <part crc="a684578c" name="5.bin"/>
        <part crc="5382f7ed" name="6.bin"/>
        <part crc="1d7109e9" name="7.bin"/>
        <part crc="049855ad" name="8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="09ed5818" name="9.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="3029f94f" name="10.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="6e.bin"/>
        <part repeat="0x3FE0">00</part>
        <part crc="8ca7b750" name="11.bin"/>
        <part crc="9b5bdc0a" name="12.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 91 01 00 00 00 02 00 00 00 30 0B 00 00 00 00
            09 00 16 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            40 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            07 ED 5E 3B 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Mandinga (Artemi Bootleg Of Amidar)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
