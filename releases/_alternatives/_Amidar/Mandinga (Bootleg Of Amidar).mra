<misterromdescription>
    <name>Mandinga (Bootleg Of Amidar)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Amidar</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>mandingag</setname>
    <parent>amidar</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FE,F1,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)" values="3,2,1,0"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="17" ids="A 1/1 B 1/6,A 2/1 B 1/3"/>
        <dip name="Bonus Life" bits="18" ids="30000 70000,50000 80000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mandingag.zip|amidar.zip">
        <part crc="792cb087" name="am2732.2c"/>
        <part crc="f7e2061c" name="am2732.2f"/>
        <part crc="25e07e4f" name="2732.2j"/>
        <part crc="79b7b4ce" name="am2732.2m"/>
        <part repeat="0xC000">00</part>
        <part crc="7e7f1e67" name="am2716.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="3029f94f" name="am2716.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="74288.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="8ca7b750" name="2532.5c"/>
        <part crc="9b5bdc0a" name="2532.5d"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 91 01 00 00 00 02 00 00 00 30 0B 00 00 00 00
            09 00 16 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            40 00 00
        </part>
    </rom>

    <remark>Mandinga (Bootleg Of Amidar)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
