        <dip name="Lives" bits="14,15" ids="3,4,5,255 (Cheat)" values="3,1,2,0"/>
        <dip name="Bonus Life" bits="17" ids="30000 70000,50000 80000"/>
        <dip name="Coinage" bits="18" ids="A 1/1 B 1/6,A 2/1 B 1/3"/>
        <dip name="Unknown" bits="19" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="20" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="22" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="olmandingo.zip|amidar.zip">
        <part crc="b5b9fcd9" name="olmandingo_1.bin"/>
        <part crc="f4038373" name="olmandingo_2.bin"/>
