<misterromdescription>
    <name>Space Train</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>War Of The Bugs Or Monsterous Manouvers In A Mushroom Maze</series>
    <year>1981</year>
    <manufacturer>Celv</manufacturer>
    <category>Shooter</category>

    <setname>spactrai</setname>
    <parent>warofbug</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,00,0E">
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,2C / 1C (duplicate,Free Play" values="1,0,2,3"/>
        <dip name="Lives" bits="16,17" ids="1,2,3,4"/>
        <dip name="Unknown" bits="18" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="19" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="spactrai.zip|warofbug.zip">
        <part crc="fabc7fd8" name="1cen.bin"/>
        <part crc="44ddacfa" name="2cen.bin"/>
        <part crc="822749cb" name="3cen.bin"/>
        <part crc="f9dda0ed" name="4cen.bin"/>
        <part crc="b8c76675" name="5cen.bin"/>
        <part repeat="0xB000">00</part>
        <part crc="a59a9f3f" name="6cen.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="9b75b40a" name="7cen.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="stk.bin"/>
    </rom>

    <!-- Index 1: Config -->
    <rom index="1">
        <part>
            1B 90 00 00 00 00 0E FF FF FF 80 01 02 80 80 80
            11 00 03 04 05 00 00 01 13 14 02 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 50 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00
        </part>
    </rom>

    <remark>Space Train (Celv)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
