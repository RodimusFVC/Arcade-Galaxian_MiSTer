<misterromdescription>
    <name>War Of The Bugs Or Monsterous Manouvers In A Mushroom Maze (US)</name>
    <region>US</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>War Of The Bugs Or Monsterous Manouvers In A Mushroom Maze</series>
    <year>1981</year>
    <manufacturer>Armenia / Super Video Games</manufacturer>
    <category>Shooter</category>

    <setname>warofbugu</setname>
    <parent>warofbug</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,0A,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,Free Play" values="1,0,3"/>
        <dip name="Lives" bits="16,17" ids="1,2,3,4"/>
        <dip name="Bonus Life" bits="19" ids="500000,750000" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="warofbugu.zip|warofbug.zip">
        <part crc="b8dfb7e3" name="wb-prog-1.7d"/>
        <part crc="fd8854e0" name="wb-prog-2.7e"/>
        <part crc="4495aa14" name="wb-prog-3.7j"/>
        <part crc="e4bd257c" name="wb-prog-4.7n"/>
        <part crc="71257bb4" name="wb-prog-5.7p"/>
        <part repeat="0xD800">00</part>
        <part crc="8100fa85" name="warofbug.1k"/>
        <part repeat="0x1800">00</part>
        <part crc="d1220ae9" name="warofbug.1j"/>
        <part repeat="0x1800">00</part>
        <part crc="8688e64b" name="warofbug.clr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 09 03 04 05 00 02 01 13 14 0B 0C 0D 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
