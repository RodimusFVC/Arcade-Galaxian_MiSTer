<misterromdescription>
    <name>Scramble (Bootleg On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scramble</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>scramblb</setname>
    <parent>scramble</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Cabinet" bits="14" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="16,17" ids="1C/1C,1C/2C,1C/3C,1C/4C"/>
        <dip name="Lives" bits="18,19" ids="3,4,5,255 (Cheat)"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="scramblb.zip|scramble.zip">
        <part crc="9e025c4a" name="scramble.1k"/>
        <part crc="306f783e" name="scramble.2k"/>
        <part crc="0500b701" name="scramble.3k"/>
        <part crc="dd380a22" name="scramble.4k"/>
        <part crc="df0b9648" name="scramble.5k"/>
        <part crc="b8c07b3c" name="scramble.1j"/>
        <part crc="88ac07a0" name="scramble.2j"/>
        <part crc="c67d57ca" name="scramble.3j"/>
        <part repeat="0xC000">00</part>
        <part crc="4708845b" name="5f.k"/>
        <part repeat="0x1800">00</part>
        <part crc="11fd2887" name="5h.k"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="82s123.6e"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            12 90 01 00 00 00 00 00 00 00 30 00 00 00 00 00
            11 0A 03 04 05 06 02 01 13 14 0B 0C 0D 0E 00 09
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            07 E0 FE 70 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Scramble (Bootleg On Galaxian Hardware)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
