<misterromdescription>
    <name>Astro Ambush (Scramble Bootleg On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scramble</series>
    <year>1981</year>
    <manufacturer>bootleg (U.C.E.)</manufacturer>
    <category>Shooter</category>

    <setname>astroamb</setname>
    <parent>scramble</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,C0,77,FF">
        <dip name="Lives" bits="14,15" ids="3,4,5,255 (Cheat)" values="3,1,2,0"/>
        <dip name="Cabinet" bits="16" ids="Cocktail,Upright"/>
        <dip name="Coinage" bits="17,18" ids="1C/1C,1C/2C,1C/3C,1C/4C" values="3,1,2,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="astroamb.zip|scramble.zip">
        <part crc="99533fcd" name="1.sub"/>
        <part crc="45fd250d" name="2.7h"/>
        <part crc="d67eedde" name="3.7k"/>
        <part crc="e4b038fd" name="4.7l"/>
        <part repeat="0xC000">00</part>
        <part crc="72e5ca44" name="a.1h"/>
        <part repeat="0x1800">00</part>
        <part crc="d3846f2b" name="b.1l"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="82s123.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            12 90 01 00 00 00 00 00 00 00 30 00 00 00 00 00
            01 02 03 04 05 06 09 0A 13 14 0B 0C 0D 0E 00 00
            00 00 00 11 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            07 ED 5E 3B 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Astro Ambush (Scramble Bootleg On Galaxian Hardware) (U.C.E. Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
