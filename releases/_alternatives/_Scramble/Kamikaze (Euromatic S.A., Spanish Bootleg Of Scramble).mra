<misterromdescription>
    <name>Kamikaze (Euromatic S.A., Spanish Bootleg Of Scramble)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scramble</series>
    <year>1981</year>
    <manufacturer>bootleg (Euromatic S.A.)</manufacturer>
    <category>Shooter</category>

    <setname>kamikazesp</setname>
    <parent>scramble</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FC,F1,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 2/1  C 1/1,A 1/2  B 1/1  C 1/2,A 1/3  B 3/1  C 1/3,A 1/4  B 4/1  C 1/4"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="kamikazesp.zip|scramble.zip">
        <part crc="ab0eef23" name="4-b.2c"/>
        <part crc="43cb40a4" name="5-b.2e"/>
        <part crc="eec265ee" name="6-b.2f"/>
        <part crc="dd380a22" name="7-b.2h"/>
        <part crc="92980e72" name="8-b.2j"/>
        <part crc="9fd96374" name="9-b.2l"/>
        <part crc="88ac07a0" name="10-b.2m"/>
        <part crc="75232e09" name="11-b.2p"/>
        <part repeat="0xC000">00</part>
        <part crc="4708845b" name="12-b.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="11fd2887" name="13-b.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="prom.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="be037cf6" name="1-a.5c"/>
        <part crc="31bb79e4" name="2-a.5d"/>
        <part crc="ba2fa933" name="3-a.5e"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 01 00 00 00 02 00 00 00 30 0B 00 00 00 00
            09 06 16 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            07 ED 5E 3B 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Kamikaze (Euromatic S.A., Spanish Bootleg Of Scramble) (Euromatic S.A. Bootleg)</remark>
