<misterromdescription>
    <name>Scramble (Okapi Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scramble</series>
    <year>1981</year>
    <manufacturer>bootleg (Okapi)</manufacturer>
    <category>Shooter</category>

    <setname>scrambleo</setname>
    <parent>scramble</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="P1 Button 1 / Start 1,P1 Button 2 / Start 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,F8,FF">
        <dip name="Coinage" bits="14,15" ids="A 1/1  B 1/6,A 2/1  B 1/3,A 1/2  B 1/6,A 2/2  B 1/3"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,255 (Cheat)"/>
        <dip name="Cabinet" bits="18" ids="Upright,Cocktail"/>
        <dip name="IN4:3" bits="19" ids="Off,On" values="1,0"/>
        <dip name="IN4:4" bits="20" ids="Off,On" values="1,0"/>
        <dip name="IN4:5" bits="21" ids="Off,On" values="1,0"/>
        <dip name="IN4:6" bits="22" ids="Off,On" values="1,0"/>
        <dip name="IN4:7" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="scrambleo.zip|scramble.zip">
        <part crc="55313343" name="1.bin"/>
        <part crc="af61bdfe" name="2.bin"/>
        <part crc="c85c613b" name="3.bin"/>
        <part crc="f055e1e3" name="4.bin"/>
        <part crc="cc059dc5" name="5.bin"/>
        <part crc="dd15f10e" name="6.bin"/>
        <part crc="0bb49470" name="7.bin"/>
        <part crc="29a15aec" name="8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="4708845b" name="gfx_h.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="11fd2887" name="gfx_m.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="413703bf" name="sc_cprom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 01 00 00 00 00 00 00 00 30 00 00 80 00 00
            11 12 03 04 01 0E 0A 02 05 06 0B 0C 09 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            08 69 1C 2C 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Scramble (Okapi Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
