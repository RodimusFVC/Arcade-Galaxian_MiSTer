<misterromdescription>
    <name>Scramble (Bootleg, Set 1)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Scramble</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>scramb2</setname>
    <parent>scramble</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F1,FF">
        <dip name="Lives" bits="8,9" ids="3,4,5,255 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 2/1,A 1/2  B 1/1,A 1/3  B 3/1,A 1/4  B 4/1"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="scramb2.zip|scramble.zip">
        <part crc="4a43148c" name="r1.7f1"/>
        <part crc="215a3b86" name="r1.7f2"/>
        <part crc="28779444" name="r2.7h1"/>
        <part crc="5b4b300b" name="r2.7h2"/>
        <part crc="b478aa53" name="r3.7k1"/>
        <part crc="c33f072e" name="r3.7k2"/>
        <part crc="88ac07a0" name="r4.7l1"/>
        <part crc="321fd003" name="r4.7l2"/>
        <part repeat="0xC000">00</part>
        <part crc="4708845b" name="r6.1j"/>
        <part repeat="0x1800">00</part>
        <part crc="11fd2887" name="r5.1l"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="82s123.6e"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            13 90 01 00 00 00 00 00 00 00 20 00 00 00 00 00
            09 06 16 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            0C 15 8C 86 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>Scramble (Bootleg, Set 1)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
