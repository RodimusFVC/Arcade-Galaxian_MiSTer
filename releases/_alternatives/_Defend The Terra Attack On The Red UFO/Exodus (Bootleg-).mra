<misterromdescription>
    <name>Exodus (Bootleg?)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Defend The Terra Attack On The Red UFO</series>
    <year>19??</year>
    <manufacturer>bootleg? (Subelectro)</manufacturer>
    <category>Shooter</category>

    <setname>exodus</setname>
    <parent>redufo</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coin B" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin A" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Bonus Life" bits="16" ids="7000,None"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="exodus.zip|redufo.zip">
        <part crc="5dfe65e1" name="exodus1.bin"/>
        <part crc="6559222f" name="exodus2.bin"/>
        <part crc="bf7030e8" name="exodus3.bin"/>
        <part crc="3607909e" name="exodus4.bin"/>
        <part crc="994a90c4" name="exodus9.bin"/>
        <part crc="fbd11187" name="exodus10.bin"/>
        <part crc="fd07d811" name="exodus11.bin"/>
        <part repeat="0xC800">00</part>
        <part crc="b34c7cb4" name="exodus5.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="50a2d447" name="exodus6.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            06 86 84 34 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
            00 00 40 AC 00 01 70 70
            00 00 55 C1 00 01 90 90
            00 00 55 A1 00 01 90 90
            00 00 56 21 00 01 10 10
            00 00 56 41 00 01 10 10
            00 00 56 01 00 01 10 10
