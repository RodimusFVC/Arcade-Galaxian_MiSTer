<misterromdescription>
    <name>Omega (Bootleg?)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>The End</series>
    <year>19??</year>
    <manufacturer>bootleg?</manufacturer>
    <category>Shooter</category>

    <setname>omegab</setname>
    <parent>theend</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Bonus Life" bits="16" ids="10000,20000"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="omegab.zip|theend.zip">
        <part crc="fc2a096b" name="omega1.bin"/>
        <part crc="ad100357" name="omega2.bin"/>
        <part crc="d7e3be79" name="omega3.bin"/>
        <part crc="42068171" name="omega4.bin"/>
        <part crc="d8a93383" name="omega5.bin"/>
        <part crc="32a42f44" name="omega6.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="527fd384" name="omega1h.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="36de42c6" name="omega1k.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="mmi6331-1j.86"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <remark>Omega (Bootleg?)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
