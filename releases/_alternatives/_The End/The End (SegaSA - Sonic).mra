<misterromdescription>
    <name>The End (SegaSA / Sonic)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>The End</series>
    <year>1981</year>
    <manufacturer>bootleg (Sonic)</manufacturer>
    <category>Shooter</category>

    <setname>theendss</setname>
    <parent>theend</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F1,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,256 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="2,1,0,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="theendss.zip|theend.zip">
        <part crc="326e1f69" name="the_end_ss_2.bin"/>
        <part crc="950f0a07" name="the_end_ss.ic14"/>
        <part crc="93b47650" name="the_end_ss_1.bin"/>
        <part crc="380a0017" name="the_end_ss.ic16"/>
        <part crc="af067b7f" name="the_end_ss.ic17"/>
        <part crc="a0411b93" name="the_end_ss.ic18"/>
        <part repeat="0xD000">00</part>
        <part crc="527fd384" name="the_end_ss.ic30"/>
        <part repeat="0x1800">00</part>
        <part crc="af6d09b6" name="the_end_ss.ic31"/>
        <part repeat="0x1800">00</part>
        <part crc="24652bc4" name="6331-1j.86"/>
        <part repeat="0x3FE0">00</part>
        <part crc="7a141f29" name="the_end_ss.ic56"/>
        <part crc="218497c1" name="the_end_ss.ic55"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 00 00 00 00 02 00 00 00 40 0B 00 00 00 00
            00 06 16 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 43 C0 00 0F 00 00
            00 00 40 A8 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="18"></nvram>

    <remark>The End (SegaSA / Sonic) (Sonic Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
