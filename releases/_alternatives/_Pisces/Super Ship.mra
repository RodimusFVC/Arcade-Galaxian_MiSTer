<misterromdescription>
    <name>Super Ship</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pisces</series>
    <year>19??</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>supershp</setname>
    <parent>pisces</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,00,00">
        <dip name="Lives" bits="14" ids="3,4"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="10000,20000"/>
        <dip name="Difficulty" bits="18" ids="Easy,Hard"/>
        <dip name="Coinage" bits="17" ids="A 2C/1C  B 1C/2C 2C/5C,A 1C/1C  B 1C/5C" values="1,0"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="supershp.zip|pisces.zip">
        <part crc="55bd4e46" name="ss_1.bin"/>
        <part crc="1e08cba8" name="ss_2.bin"/>
        <part crc="bab514fa" name="ss_3.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="2dba9e0e" name="ss_j.j1"/>
        <part repeat="0x1000">00</part>
        <part crc="cdc5aa26" name="ss_k.k1"/>
        <part repeat="0x1000">00</part>
        <part crc="57a45057" name="colour.bin"/>
    </rom>

    <!-- Index 1: Config -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 FF FF FF 80 01 02 80 80 80
            12 11 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 20 00 03 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00
        </part>
    </rom>

    <remark>Super Ship (Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
