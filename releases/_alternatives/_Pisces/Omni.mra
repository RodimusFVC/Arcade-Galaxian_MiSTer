<misterromdescription>
    <name>Omni</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pisces</series>
    <year>19??</year>
    <manufacturer>bootleg (Videa System)</manufacturer>
    <category>Shooter</category>

    <setname>omni</setname>
    <parent>pisces</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Lives" bits="14" ids="3,4"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="10000,20000"/>
        <dip name="Difficulty" bits="18" ids="Easy,Hard"/>
        <dip name="Coinage" bits="17" ids="A 2C/1C  B 1C/2C 2C/5C,A 1C/1C  B 1C/5C" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="omni.zip|pisces.zip">
        <part crc="a9b7acc6" name="omni1.7f"/>
        <part crc="6ade29b7" name="omni2.7j"/>
        <part crc="9e37bb24" name="omni3.7f"/>
        <part repeat="0xD000">00</part>
        <part crc="9503a23a" name="omni5b.l1"/>
        <part crc="0adfc3fe" name="omni6c.j22"/>
        <part repeat="0x1000">00</part>
        <part crc="3e61f849" name="omni4a.j1"/>
        <part crc="7130e9eb" name="omni7d.l2"/>
        <part repeat="0x1000">00</part>
        <part crc="57a45057" name="colour.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 20 00 03 00 00 00 00 00 00 00 00 00 00
            12 11 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 21 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="3"></nvram>

    <remark>Omni (Videa System Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
