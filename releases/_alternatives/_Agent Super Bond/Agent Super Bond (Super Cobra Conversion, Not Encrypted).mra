<misterromdescription>
    <name>Agent Super Bond (Super Cobra Conversion, Not Encrypted)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Agent Super Bond</series>
    <year>1984</year>
    <manufacturer>Video Village</manufacturer>
    <category>Shooter</category>

    <setname>superbona</setname>
    <parent>superbon</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FD,F3,FF">
        <dip name="Lives" bits="8,9" ids="3,5,Free Play,Invulnerability (Cheat)" values="1,2,3,0"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 1/1,A 1/2  B 2/1,A 1/3  B 3/1,A 1/4  B 4/1" values="1,0,2,3"/>
        <dip name="Demo Sounds" bits="19" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="superbona.zip|superbon.zip">
        <part crc="5a8f69b5" name="2c"/>
        <part crc="5a126243" name="2e"/>
        <part crc="bb66c2d5" name="2f"/>
        <part crc="74f4f04d" name="2h"/>
        <part crc="78effb08" name="2j"/>
        <part crc="e9dcecbd" name="2l"/>
        <part crc="3ed0337e" name="2m"/>
        <part repeat="0x9000">00</part>
        <part crc="d26f3fdc" name="5f"/>
        <part repeat="0x1800">00</part>
        <part crc="08e093ee" name="5h"/>
        <part repeat="0x1800">00</part>
        <part crc="9b87f90d" name="82s123.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="b899be2a" name="5c"/>
        <part crc="f2ebd14c" name="5d"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 90 01 00 80 00 02 00 00 00 30 03 00 00 00 00
            14 13 01 02 04 03 12 11 00 00 00 06 00 00 05 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
