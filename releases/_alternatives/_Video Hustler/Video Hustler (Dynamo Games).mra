<misterromdescription>
    <name>Video Hustler (Dynamo Games)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Video Hustler</series>
    <year>1981</year>
    <manufacturer>Konami (Dynamo Games license)</manufacturer>
    <category>Shooter</category>

    <setname>hustlerd</setname>
    <parent>hustler</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FE,F1,FF">
        <dip name="Lives" bits="8,9" ids="1,2,3,Infinite (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="2,1,0,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="hustlerd.zip|hustler.zip">
        <part crc="7cb6a940" name="vh1.ic5"/>
        <part crc="4ca45239" name="vh2.ic6"/>
        <part crc="4c752453" name="vh3.ic7"/>
        <part repeat="0xD000">00</part>
        <part crc="0bdfad0e" name="hc2"/>
        <part repeat="0x1800">00</part>
        <part crc="8e062177" name="hc1"/>
        <part repeat="0x1800">00</part>
        <part crc="aa1f7f5e" name="hustler.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="7a946544" name="ho1.ic32"/>
        <part crc="3db57351" name="ho2.ic33"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            09 90 01 00 80 00 02 00 00 00 00 05 00 00 01 00
            09 00 16 05 04 03 12 11 00 00 00 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 84 C0 00 0E 00 00
            00 00 80 A8 00 03 00 02
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="17"></nvram>

    <remark>Video Hustler (Dynamo Games) (Konami (Dynamo Games License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
