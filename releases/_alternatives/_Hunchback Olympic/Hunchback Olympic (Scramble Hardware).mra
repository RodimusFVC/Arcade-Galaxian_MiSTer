<misterromdescription>
    <name>Hunchback Olympic (Scramble Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Hunchback Olympic</series>
    <year>1984</year>
    <manufacturer>Seatongrove UK, Ltd.</manufacturer>
    <category>Shooter</category>

    <setname>hncholms</setname>
