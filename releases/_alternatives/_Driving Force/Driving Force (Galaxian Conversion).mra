        <dip name="Unknown" bits="28" ids="Off,On"/>
        <dip name="Unknown" bits="29" ids="Off,On"/>
        <dip name="Unknown" bits="30" ids="Off,On"/>
        <dip name="Unknown" bits="31" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="drivfrcg.zip|drivfrcp.zip">
        <part crc="52d5e77d" name="dfgp1.bin" offset="0x800" length="0x400"/>
        <part crc="52d5e77d" name="dfgp1.bin" offset="0xC00" length="0x400"/>
