<misterromdescription>
    <name>Driving Force (Galaxian Conversion)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Driving Force</series>
    <year>1984</year>
    <manufacturer>Shinkai Inc. (Magic Electronics USA license)</manufacturer>
    <category>Shooter</category>

    <setname>drivfrcg</setname>
    <parent>drivfrcp</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,00">
        <dip name="Coinage" bits="14" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/5C" values="1,0"/>
        <dip name="Unknown" bits="16" ids="Off,On"/>
        <dip name="Unknown" bits="17" ids="Off,On"/>
        <dip name="Unknown" bits="18" ids="Off,On"/>
        <dip name="Unknown" bits="19" ids="Off,On"/>
        <dip name="Unknown" bits="20" ids="Off,On"/>
        <dip name="Unknown" bits="21" ids="Off,On"/>
        <dip name="Unknown" bits="22" ids="Off,On"/>
        <dip name="Unknown" bits="23" ids="Off,On"/>
        <dip name="Unknown" bits="24" ids="Off,On"/>
