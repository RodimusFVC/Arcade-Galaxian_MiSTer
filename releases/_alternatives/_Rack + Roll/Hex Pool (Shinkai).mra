        <dip name="Unknown" bits="23" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="hexpool.zip|racknrol.zip">
        <part crc="bdb078fc" name="vert_p.bin" offset="0x0" length="0x1000"/>
        <part crc="bdb078fc" name="vert_p.bin" offset="0x1000" length="0x1000"/>
        <part crc="bdb078fc" name="vert_p.bin" offset="0x2000" length="0x1000"/>
        <part crc="bdb078fc" name="vert_p.bin" offset="0x3000" length="0x1000"/>
        <part repeat="0xC000">00</part>
        <part crc="7e257e80" name="vert_g.bin" offset="0x0" length="0x2000"/>
        <part crc="c5f0851e" name="vert_r.bin" offset="0x0" length="0x2000"/>
        <part crc="737802bf" name="82s123.bin"/>
        <part repeat="0xE0">00</part>
        <part crc="aace7fa5" name="82s147.bin" offset="0x0" length="0x40"/>
        <part repeat="0xFEC0">00</part>
        <part crc="7e257e80" name="vert_g.bin" offset="0x2000" length="0x2000"/>
        <part crc="c5f0851e" name="vert_r.bin" offset="0x2000" length="0x2000"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
