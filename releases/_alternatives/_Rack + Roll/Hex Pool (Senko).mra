        <part crc="2ca8018d" name="rom.4l" offset="0x0" length="0x1000"/>
        <part crc="2ca8018d" name="rom.4l" offset="0x1000" length="0x1000"/>
        <part crc="2ca8018d" name="rom.4l" offset="0x2000" length="0x1000"/>
