<misterromdescription>
    <name>Mighty Monkey (Bootleg On Scramble Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mighty Monkey</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>mimonscr</setname>
    <parent>mimonkey</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FC,51,00">
        <dip name="Lives" bits="8,9" ids="3,4,5,6"/>
        <dip name="Coinage" bits="17,18" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="3,1,0,2"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Infinite Lives (Cheat)" bits="21" ids="Off,On"/>
        <dip name="Auto Fire" bits="23" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mimonscr.zip|mimonkey.zip">
        <part crc="0399a0c4" name="mm1"/>
        <part crc="2c5e971e" name="mm2"/>
        <part crc="24ce1ce3" name="mm3"/>
        <part crc="c83fb639" name="mm4"/>
        <part repeat="0x8000">00</part>
        <part crc="a9f12dfc" name="mm5"/>
