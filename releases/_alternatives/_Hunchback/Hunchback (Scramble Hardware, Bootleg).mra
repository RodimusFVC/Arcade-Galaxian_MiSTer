<misterromdescription>
    <name>Hunchback (Scramble Hardware, Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Hunchback</series>
    <year>1983</year>
    <manufacturer>bootleg (Sig)</manufacturer>
    <category>Shooter</category>

    <setname>hunchbks2</setname>
    <parent>hunchbak</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,F1,FF">
        <dip name="Lives" bits="8" ids="3,5" values="1,0"/>
        <dip name="Coinage" bits="9" ids="A 2/1 B 1/3,A 1/1 B 1/5" values="1,0"/>
        <dip name="Bonus Life" bits="17,18" ids="10000,20000,40000,80000"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="hunchbks2.zip|hunchbak.zip">
        <part crc="fec3466a" name="hb01.bin"/>
        <part crc="07de4229" name="2e_hb02.bin"/>
        <part crc="b75a0dfc" name="2f_hb03.bin"/>
        <part crc="731e349b" name="hb04.bin"/>
        <part crc="1bb78728" name="2j_hb05.bin"/>
        <part crc="f25ed680" name="2l_hb06.bin"/>
        <part crc="c72e0e17" name="2m_hb07.bin"/>
        <part crc="412087b0" name="2p_hb08.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="db489c3d" name="5f_hb09.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="3977650e" name="5h_hb10.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="01004d3f" name="6e_prom.bin"/>
        <part repeat="0x3FE0">00</part>
        <part crc="88226086" name="11d_snd.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 01 00 00 00 02 00 00 00 20 03 00 00 40 00
            09 06 00 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00 00 16
        </part>
    </rom>

    <remark>Hunchback (Scramble Hardware, Bootleg) (Sig Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
