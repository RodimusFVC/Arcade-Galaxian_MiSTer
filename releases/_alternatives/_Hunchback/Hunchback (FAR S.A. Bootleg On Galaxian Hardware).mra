        <part crc="d2731d27" name="7.bin"/>
        <part crc="e4b1a666" name="8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="83ecf8f4" name="lk.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="106889ec" name="jh.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="2430f47c" name="74s288n.bin"/>
    </rom>

