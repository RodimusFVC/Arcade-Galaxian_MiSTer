<misterromdescription>
    <name>Hunchback (FAR S.A. Bootleg On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Hunchback</series>
    <year>1983</year>
    <manufacturer>bootleg (FAR S.A.)</manufacturer>
    <category>Shooter</category>

    <setname>hunchbgb</setname>
    <parent>hunchbak</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="P1 Start/Red,P1 Down,Button 3,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,B,X,Select,Start,R,L"/>

    <switches default="00,00,00">
        <dip name="Coinage" bits="14" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/5C" values="1,0"/>
        <dip name="Lives" bits="15" ids="3,5" values="1,0"/>
        <dip name="Cabinet" bits="16" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="17,18" ids="10000,20000,40000,80000"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="hunchbgb.zip|hunchbak.zip">
        <part crc="46590e9b" name="1.bin"/>
        <part crc="4e6e671c" name="2.bin"/>
        <part crc="d29dc242" name="3.bin"/>
