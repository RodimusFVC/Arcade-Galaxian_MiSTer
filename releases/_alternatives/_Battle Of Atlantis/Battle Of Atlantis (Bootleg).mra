<misterromdescription>
    <name>Battle Of Atlantis (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Battle Of Atlantis</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>atlantisb</setname>
    <parent>atlantis</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,80,FD,FF">
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Unknown" bits="16" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="17" ids="Easy,Hard"/>
        <dip name="Unknown" bits="20" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="22" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="18" ids="3,5" values="1,0"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="atlantisb.zip|atlantis.zip">
        <part crc="2b612351" name="1"/>
        <part crc="b1c970e9" name="2"/>
        <part repeat="0x800">00</part>
        <part crc="63c3783e" name="3"/>
        <part crc="45f7cf34" name="4"/>
        <part crc="f335b96b" name="5"/>
        <part crc="a50bf8d5" name="6"/>
        <part repeat="0xC800">00</part>
        <part crc="55cd5acd" name="8"/>
        <part repeat="0x1800">00</part>
        <part crc="72e773b8" name="7"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="sn74s288n.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 10 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 02 09 01 13 14 0B 0C 0D 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <remark>Battle Of Atlantis (Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
