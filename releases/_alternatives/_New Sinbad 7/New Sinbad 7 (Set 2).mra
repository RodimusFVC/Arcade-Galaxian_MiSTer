<misterromdescription>
    <name>New Sinbad 7 (Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>New Sinbad 7</series>
