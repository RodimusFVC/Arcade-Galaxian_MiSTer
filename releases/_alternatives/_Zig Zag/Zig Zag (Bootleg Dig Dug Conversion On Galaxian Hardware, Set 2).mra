<misterromdescription>
    <name>Zig Zag (Bootleg Dig Dug Conversion On Galaxian Hardware, Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Zig Zag</series>
