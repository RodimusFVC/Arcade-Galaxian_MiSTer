<misterromdescription>
    <name>The Pit (Bootleg On Moon Quasar Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>The Pit</series>
    <year>198?</year>
    <manufacturer>bootleg (KZH)</manufacturer>
    <category>Shooter</category>

    <setname>thepitm</setname>
    <parent>thepit</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Coinage" bits="14,15" ids="1C/1C,3C/2C,2C/1C,Free Play" values="0,2,1,3"/>
        <dip name="Game Speed" bits="16" ids="Slow,Fast"/>
        <dip name="Time Limit" bits="17" ids="Long,Short"/>
        <dip name="Flip Screen" bits="18" ids="Off,On"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="thepitm.zip|thepit.zip">
        <part crc="0f78d6ea" name="1.bin"/>
        <part crc="ebacc6eb" name="2.bin"/>
        <part crc="14fd0706" name="3.bin"/>
        <part crc="613e920f" name="4.bin"/>
        <part crc="5a791f3f" name="5.bin"/>
        <part crc="0bb37f51" name="6.bin"/>
        <part crc="4dfdec6f" name="7.bin"/>
        <part crc="a39a9189" name="8.bin"/>
        <part crc="2eb90e07" name="9.bin"/>
        <part repeat="0xB800">00</part>
        <part crc="00dce65f" name="1h.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="3ec0056e" name="1k.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="6l.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 44 48 01 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 05 0A 02 13 14 0B 0C 09 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 82 83 00 17 14 00
            00 00 80 39 00 0F 14 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="38"></nvram>

    <remark>The Pit (Bootleg On Moon Quasar Hardware) (KZH Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
