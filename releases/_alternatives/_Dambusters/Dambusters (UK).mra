<misterromdescription>
    <name>Dambusters (UK)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Dambusters</series>
    <year>1981</year>
    <manufacturer>South West Research</manufacturer>
    <category>Shooter</category>

    <setname>dambustruk</setname>
    <parent>dambustr</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="Fire,Button 2,Button 3,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="10,C0,FF,00">
        <dip name="Coin Counters" bits="14" ids="1,2"/>
        <dip name="Coinage" bits="15" ids="1C/1C / A 1/1  B 1/6,1C/2C / A 1/2  B 1/12" values="1,0"/>
        <dip name="Lives" bits="24,25" ids="3,4,5,6" values="0,2,1,3"/>
        <dip name="Disable Background Collision (Cheat)" bits="26" ids="Off,On"/>
        <dip name="Union Jack Flag" bits="27" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="dambustruk.zip|dambustr.zip">
        <part repeat="0x4000">00</part>
        <part crc="fd041ff4" name="db8.pr8"/>
        <part crc="35dcee01" name="db6p.bin"/>
        <part crc="675b1f5e" name="db7.pr7"/>
        <part crc="75659ecc" name="db5.pr5"/>
        <part crc="9e6b34fe" name="db11.bin"/>
        <part crc="57164563" name="db9.pr9"/>
        <part crc="c129c57b" name="db10p.bin"/>
        <part crc="ea4c65f5" name="db12.bin"/>
        <part repeat="0x4000">00</part>
        <part crc="9e9a9710" name="db3.pr3"/>
        <part crc="4cb964cd" name="db1ap.pr1"/>
        <part crc="d9d2df33" name="db4.pr3"/>
        <part crc="0a0a6af5" name="db2.pr2"/>
        <part crc="f131f92f" name="mi-7603-5.ic4"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            1D 91 01 00 00 00 00 00 00 00 00 00 00 00 00 00
            12 11 14 13 00 00 16 07 06 05 04 03 02 01 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <remark>Dambusters (UK) (South West Research)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
