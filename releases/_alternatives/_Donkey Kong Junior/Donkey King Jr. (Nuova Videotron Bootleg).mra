<misterromdescription>
    <name>Donkey King Jr. (Nuova Videotron Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Donkey King Jr.</series>
