        <part crc="6a65d58d" name="port4.bin" offset="0x800" length="0x800"/>
        <part crc="2978a9aa" name="port5.bin"/>
        <part crc="7ecdffb5" name="port6.bin"/>
        <part repeat="0xB000">00</part>
        <part crc="603294f9" name="port7.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="b66a763d" name="port8.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 63 50 03 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 0E 0A 02 05 06 0B 0C 09 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
