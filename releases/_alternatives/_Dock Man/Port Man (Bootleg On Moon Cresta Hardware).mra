<misterromdescription>
    <name>Port Man (Bootleg On Moon Cresta Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Port Man</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>porter</setname>
    <parent>dockman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,07,FF">
        <dip name="Bonus Life" bits="14" ids="10000 only,30000 only"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="16" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/6C"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="porter.zip|dockman.zip">
        <part crc="babaf7fe" name="port1.bin" offset="0x0" length="0x800"/>
        <part crc="8f7eb0e3" name="port2.bin" offset="0x0" length="0x800"/>
        <part crc="683939b5" name="port3.bin" offset="0x0" length="0x800"/>
        <part crc="6a65d58d" name="port4.bin" offset="0x0" length="0x800"/>
