<misterromdescription>
    <name>El Estivador (Spanish Bootleg Of Port Man On Galaxian Hardware)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>El Estivador</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>portera</setname>
    <parent>dockman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,07,FF">
        <dip name="Bonus Life" bits="14" ids="10000 only,30000 only"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Coinage" bits="16" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/6C"/>
        <dip name="Lives" bits="18,19" ids="2,3,4,5"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="portera.zip|dockman.zip">
        <part crc="09b80d10" name="port_man_sub_1.a1"/>
        <part crc="c86973fb" name="port_man_sub_2.a2"/>
        <part crc="610b2da8" name="port_man_sub_3.b2"/>
        <part crc="5a3b3584" name="port_man_sub_4.c1"/>
        <part crc="2a34cfba" name="port_man_sub_5.d1"/>
        <part crc="58c01681" name="port_man_sub_6.e2"/>
        <part crc="72a38ad0" name="port_man_sub_7.f2"/>
        <part crc="d7017450" name="port_man_sub_8.f1"/>
        <part crc="2459fe44" name="port_man_sub_9.1d"/>
        <part repeat="0xB000">00</part>
        <part crc="71e3debd" name="port_man_4k.kl"/>
        <part repeat="0x1000">00</part>
        <part crc="b66a763d" name="port_man_4k.hj"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="port_man_82s123.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 63 50 03 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 0E 02 0A 05 06 0B 0C 09 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
