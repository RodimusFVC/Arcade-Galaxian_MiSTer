<misterromdescription>
    <name>Crazy Kong (Bootleg On Scramble Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Kong</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>ckongs</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F5,FF,FF">
        <dip name="Cabinet" bits="17" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="18" ids="3,4" values="1,0"/>
        <dip name="Coinage" bits="32,34" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/2C,1C/3C,1C/4C" values="0,1,4,5,7,6,3,2"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="ckongs.zip|ckong.zip">
        <part crc="49a8c234" name="vid_2c.bin"/>
        <part crc="f1b667f1" name="vid_2e.bin"/>
        <part crc="b194b75d" name="vid_2f.bin"/>
        <part crc="2052ba8a" name="vid_2h.bin"/>
        <part crc="b377afd0" name="vid_2j.bin"/>
        <part crc="fe65e691" name="vid_2l.bin"/>
        <part repeat="0xA000">00</part>
        <part crc="7866d2cb" name="vid_5f.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="7311a101" name="vid_5h.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="5039af97" name="vid_6e.bin"/>
        <part repeat="0x3FE0">00</part>
        <part crc="f0c30f9a" name="turt_snd.5c"/>
        <part crc="892c9547" name="snd_5d.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            17 91 01 00 60 06 02 00 00 00 20 03 00 00 00 00
            09 00 00 05 04 03 12 11 30 31 00 0D 0C 0B 14 13
            0A 00 00 32 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 7B BD F1 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 61 00 00 AA 94 92
            00 00 60 B8 00 03 50 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="173"></nvram>

    <remark>Crazy Kong (Bootleg On Scramble Hardware)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
