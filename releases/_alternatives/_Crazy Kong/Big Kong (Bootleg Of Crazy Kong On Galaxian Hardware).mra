<misterromdescription>
    <name>Big Kong (Bootleg Of Crazy Kong On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Big Kong</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>bigkonggx</setname>
    <parent>ckong</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,80,00,FF">
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="bigkonggx.zip|ckong.zip">
        <part crc="4d7de80d" name="gc1.a"/>
        <part crc="fda78222" name="gc2.a"/>
        <part crc="0f40ce30" name="gc3.a"/>
        <part crc="50b653c0" name="gc4.a"/>
        <part repeat="0x9400">00</part>
        <part crc="a67da7d2" name="gc5.a"/>
        <part repeat="0x1C00">00</part>
        <part crc="7866d2cb" name="gc.h1"/>
        <part repeat="0x1000">00</part>
        <part crc="7311a101" name="gc.k1"/>
        <part repeat="0x1000">00</part>
        <part crc="7e0b79cb" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            16 91 01 04 40 06 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 02 0D 05 13 14 0B 0C 09 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            A0 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            0F 14 BF C2 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 61 09 00 A1 00 92
            00 00 60 B8 00 03 50 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="164"></nvram>

    <remark>Big Kong (Bootleg Of Crazy Kong On Galaxian Hardware)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
