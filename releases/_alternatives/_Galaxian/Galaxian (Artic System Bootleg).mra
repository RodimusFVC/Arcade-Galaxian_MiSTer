<misterromdescription>
    <name>Galaxian (Artic System Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg (Artic System)</manufacturer>
    <category>Shooter</category>

    <setname>galartic</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,C0,03">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="A 2C/1C  B 1C/3C,A 2C/1C  B 1C/5C,A 1C/1C  B 1C/3C,A 1C/1C  B 1C/5C" values="2,0,3,1"/>
        <dip name="Bonus Life" bits="16" ids="None,7000" values="1,0"/>
        <dip name="Unknown" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="galartic.zip|galaxian.zip">
        <part crc="78dd272d" name="piii.1"/>
        <part crc="465a9b45" name="piii.2"/>
        <part crc="03e36737" name="piii.3"/>
        <part crc="ce012b3f" name="piii.4"/>
        <part crc="9ace06cf" name="piii.5"/>
        <part repeat="0xD800">00</part>
        <part crc="977e37cf" name="piii.6"/>
        <part repeat="0x1800">00</part>
        <part crc="d0ba22c9" name="piii.7"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="mmi6331.6l"/>
    </rom>

    <!-- Index 1: Config -->
    <rom index="1">
        <part>
            00 10 00 00 00 C0 03 FF FF FF 00 01 02 80 80 80
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00
        </part>
    </rom>

    <!-- Index 3: Hiscore -->
    <rom index="3" md5="none">
        <part>
            06 7A 24 69 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
        </part>
    </rom>
    <!-- Index 4: NVRAM -->
    <rom index="4"></rom>
