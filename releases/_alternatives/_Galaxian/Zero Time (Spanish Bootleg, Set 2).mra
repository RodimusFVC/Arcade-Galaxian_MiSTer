<misterromdescription>
    <name>Zero Time (Spanish Bootleg, Set 2)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>zerotimeb</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,40,03,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="A 1C/1C 2C/2C  B 1C/2C,A 1C/1C 2C/3C  B 1C/3C,A 1C/2C 2C/4C  B 1C/4C,A 1C/2C 2C/5C  B 1C/5C" values="1,3,0,2"/>
        <dip name="Bonus Life" bits="16,17" ids="6000,7000,9000,None" values="3,2,1,0"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Difficulty" bits="19" ids="Easy,Hard"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="zerotimeb.zip|galaxian.zip">
        <part crc="90a2bc61" name="p01-6b52-2716.bin"/>
        <part crc="a433067e" name="p02-f499-2716.bin"/>
        <part crc="aaf038d4" name="p03a-eh61-2716.bin"/>
        <part crc="786d690a" name="p04-17c7-2716.bin"/>
        <part crc="af9260d7" name="p05-07fe-2716.bin"/>
        <part repeat="0xD800">00</part>
        <part crc="39546539" name="7-2716.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="d10337c3" name="6-2716.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="c3ac9467" name="mb7051.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Zero Time (Spanish Bootleg, Set 2)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
