<misterromdescription>
    <name>Galaxy X (Bootleg Of Galaxian)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>galaxyx</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,00,01">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="None,4000,5000,7000"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="galaxyx.zip|galaxian.zip">
        <part crc="d493cfd1" name="sg1"/>
        <part crc="f58283e3" name="sg2"/>
        <part crc="4c7031c0" name="sg3"/>
        <part crc="04329e33" name="sg4"/>
        <part crc="878de26d" name="sg5.7l"/>
        <part repeat="0xD800">00</part>
        <part crc="39fb43a4" name="sg6.1h"/>
        <part repeat="0x1800">00</part>
        <part crc="7e3f56a2" name="sg7.1k"/>
        <part repeat="0x1800">00</part>
        <part crc="c3ac9467" name="sgprom.6l"/>
    </rom>

    <!-- Index 1: Config -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 01 FF FF FF 00 01 02 80 80 80
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00
        </part>
    </rom>

    <!-- Index 3: Hiscore -->
    <rom index="3" md5="none">
        <part>
            06 7A 24 69 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
        </part>
    </rom>
    <!-- Index 4: NVRAM -->
    <rom index="4"></rom>
    <nvram index="4" size="3"></nvram>

    <remark>Galaxy X (Bootleg Of Galaxian)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
