<misterromdescription>
    <name>Galaktron (Sede 3)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg (Sede 3)</manufacturer>
    <category>Shooter</category>

    <setname>galaktrons3</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,40,03,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="A 1C/1C 2C/2C  B 1C/2C,A 1C/1C 2C/3C  B 1C/3C,A 1C/2C 2C/4C  B 1C/4C,A 1C/2C 2C/5C  B 1C/5C" values="1,3,0,2"/>
        <dip name="Bonus Life" bits="16,17" ids="6000,7000,9000,None" values="3,2,1,0"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Difficulty" bits="19" ids="Easy,Hard"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="galaktrons3.zip|galaxian.zip">
        <part crc="7fa16c70" name="1b.1b"/>
        <part crc="afec8adb" name="2b.2b"/>
        <part crc="770988b5" name="3b.3b"/>
        <part crc="de7e7770" name="4b.4b"/>
        <part crc="8718391e" name="5b.5b"/>
        <part crc="9175882b" name="6b.6b"/>
        <part crc="6a57f9e8" name="7a.7a"/>
        <part crc="8eeb4c6f" name="8a.8a"/>
        <part crc="7bd2befa" name="9a.9a"/>
        <part crc="05bf58ed" name="10a.10a"/>
        <part repeat="0xD800">00</part>
        <part crc="833e112c" name="7.7a"/>
        <part repeat="0x1800">00</part>
        <part crc="eca21395" name="9.9a"/>
        <part repeat="0x1800">00</part>
        <part crc="24652bc4" name="ims5610.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Galaktron (Sede 3) (Sede 3 Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
