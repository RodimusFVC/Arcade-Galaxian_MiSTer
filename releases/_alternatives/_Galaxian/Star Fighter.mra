<misterromdescription>
    <name>Star Fighter</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg (Jeutel)</manufacturer>
    <category>Shooter</category>

    <setname>starfght</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="10000,20000,40000,None" values="1,2,3,0"/>
        <dip name="Lives" bits="18" ids="3,4"/>
        <dip name="Difficulty" bits="19" ids="Easy,Hard"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="starfght.zip|galaxian.zip">
        <part crc="c6ab558b" name="ja.1"/>
        <part crc="34b99fed" name="jb.2"/>
        <part crc="30e28016" name="jc.3"/>
        <part crc="de7e7770" name="jd.4"/>
        <part crc="a916c919" name="je.5"/>
        <part crc="9175882b" name="jf.6"/>
        <part crc="707c0f02" name="jg.7"/>
        <part crc="5dd26461" name="jh.8"/>
        <part crc="6651fe93" name="ji.9"/>
        <part crc="12c721b9" name="jj.10"/>
        <part repeat="0xD800">00</part>
        <part crc="977e37cf" name="k1.7a"/>
        <part repeat="0x1800">00</part>
        <part crc="15e387ce" name="k2.9a"/>
        <part repeat="0x1800">00</part>
        <part crc="24652bc4" name="mmi6331.7f"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            06 3C 45 70 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
            00 00 52 41 00 01 10 10
            00 00 52 21 00 01 10 10
            00 00 52 01 00 01 10 10
            00 00 51 E1 00 01 10 10
            00 00 51 C1 00 01 90 90
            00 00 51 A1 00 01 90 90
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="9"></nvram>

    <remark>Star Fighter (Jeutel Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
