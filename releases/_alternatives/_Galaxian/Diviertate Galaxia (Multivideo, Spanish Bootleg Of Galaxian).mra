<misterromdescription>
    <name>Diviertate Galaxia (Multivideo, Spanish Bootleg Of Galaxian)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Galaxian</series>
    <year>1979</year>
    <manufacturer>bootleg (Multivideo)</manufacturer>
    <category>Shooter</category>

    <setname>galaxiamv</setname>
    <parent>galaxian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,04,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="7000,10000,12000,20000"/>
        <dip name="Lives" bits="18" ids="2,3"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="galaxiamv.zip|galaxian.zip">
        <part crc="7fa16c70" name="1-2708.bin"/>
        <part crc="afec8adb" name="2-2708.bin"/>
        <part crc="770988b5" name="3-2708.bin"/>
        <part crc="de7e7770" name="4-2708.bin"/>
        <part crc="a916c919" name="5-2708.bin"/>
        <part crc="9175882b" name="6-2708.bin"/>
        <part crc="6a57f9e8" name="7-2708.bin"/>
        <part crc="8eeb4c6f" name="8-2708.bin"/>
        <part crc="de598114" name="9-2708.bin"/>
        <part crc="9ec63321" name="10-2708.bin"/>
        <part repeat="0xD800">00</part>
        <part crc="977e37cf" name="11-tms2516.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="d0ba22c9" name="12-tms2516.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="24652bc4" name="mmi6331.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Diviertate Galaxia (Multivideo, Spanish Bootleg Of Galaxian) (Multivideo Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
