<misterromdescription>
    <name>Ameisenbaer (German Bootleg On Galaxian Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Anteater</series>
    <year>1982</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>anteatergg</setname>
    <parent>anteater</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,40,00,FF">
        <dip name="Demo Sounds" bits="14" ids="Off,On"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Coinage" bits="18,19" ids="A 2/1 B 1/3,A 1/1 B 1/5,A 1/5 B 1/1,A 1/3 B 2/1" values="1,0,2,3"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="anteatergg.zip|anteater.zip">
        <part crc="e28cd0be" name="for1.bin"/>
        <part crc="be8de95c" name="for2.bin"/>
        <part crc="5d79f4d0" name="for3.bin"/>
        <part crc="b8d981a5" name="for4.bin"/>
        <part crc="cdc89fda" name="for5.bin"/>
        <part crc="8a80f838" name="for6.bin"/>
        <part crc="41966df4" name="for7.bin"/>
        <part crc="dc58265c" name="for8.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="1e2824b1" name="forb.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="784319b3" name="fora.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="fce333c7" name="colr6f.cpu"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 91 00 02 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 05 0A 02 13 14 0B 0C 09 0D 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <remark>Ameisenbaer (German Bootleg On Galaxian Hardware)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
