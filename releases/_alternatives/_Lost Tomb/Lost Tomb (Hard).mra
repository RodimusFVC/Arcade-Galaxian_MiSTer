<misterromdescription>
    <name>Lost Tomb (Hard)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Lost Tomb</series>
    <year>1982</year>
    <manufacturer>Stern Electronics</manufacturer>
    <category>Shooter</category>

    <setname>losttombh</setname>
    <parent>losttomb</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin joysticks (right stick = fire directions)</special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire,Fire Down,Fire Left,Fire Right,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,F3,FF">
        <dip name="Lives" bits="8,9" ids="3,5,Free Play,Invulnerability (Cheat)" values="1,2,3,0"/>
        <dip name="Coinage" bits="17,18" ids="A 1/1  B 1/1,A 1/2  B 2/1,A 1/3  B 3/1,A 1/4  B 4/1" values="1,0,2,3"/>
        <dip name="Demo Sounds" bits="19" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="losttombh.zip|losttomb.zip">
        <part crc="d6176d2c" name="2c"/>
        <part crc="a5f55f4a" name="2e"/>
        <part crc="0169fa3c" name="2f"/>
        <part crc="e32cbf0e" name="lthard"/>
        <part crc="249ee040" name="2j"/>
        <part crc="c7d2e608" name="2l"/>
        <part crc="bc4bc5b1" name="2m"/>
        <part repeat="0x9000">00</part>
        <part crc="61f137e7" name="5f"/>
        <part repeat="0x1800">00</part>
        <part crc="5581de5f" name="5h"/>
        <part repeat="0x1800">00</part>
        <part crc="1108b816" name="ltprom"/>
        <part repeat="0x3FE0">00</part>
        <part crc="b899be2a" name="5c"/>
        <part crc="6907af31" name="5d"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 98 01 00 80 00 02 00 00 00 30 03 00 00 00 00
            14 13 01 02 04 03 12 11 00 00 05 06 08 07 05 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 01 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            02 77 15 80 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 81 10 00 50 03 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="80"></nvram>

    <remark>Lost Tomb (Hard) (Stern Electronics)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
