<misterromdescription>
    <name>Frogger (Moon Cresta Hardware)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Frogger</series>
    <year>1981</year>
    <manufacturer>Konami (Sega license)</manufacturer>
    <category>Shooter</category>

    <setname>froggermc</setname>
    <parent>frogger</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,07,00">
        <dip name="Lives" bits="14,15" ids="3,5,7,256 (Cheat)" values="3,2,1,0"/>
        <dip name="Cabinet" bits="16" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="17,18" ids="A 2/1 B 2/1 C 2/1,A 2/1 B 1/3 C 2/1,A 1/1 B 1/1 C 1/1,A 1/1 B 1/6 C 1/1" values="1,2,3,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="froggermc.zip|frogger.zip">
        <part crc="4b7c8d11" name="epr-1031.15"/>
        <part crc="ac00b9d9" name="epr-1032.16"/>
        <part crc="bc1d6fbc" name="epr-1033.33"/>
        <part crc="9efe7399" name="epr-1034.34"/>
        <part repeat="0xC000">00</part>
        <part crc="05f7d883" name="epr-1037.1h"/>
        <part repeat="0x1800">00</part>
        <part crc="658745f8" name="epr-1036.1k"/>
        <part repeat="0x1800">00</part>
        <part crc="413703bf" name="pr-91.6l"/>
        <part repeat="0x3FE0">00</part>
        <part crc="802843c2" name="epr-1082.42"/>
        <part crc="14e74148" name="epr-1035.43"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 91 00 07 00 00 02 00 04 00 06 05 00 00 00 00
            11 12 03 04 01 02 00 16 13 14 0B 0C 09 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 40
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 83 F1 00 0A 63 01
            00 00 83 EF 00 02 63 04
        </part>
    </rom>
    <rom index="4"></rom>
