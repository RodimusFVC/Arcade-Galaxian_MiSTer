<misterromdescription>
    <name>Frogger (Nuova Videotron Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Frogger</series>
    <year>1981</year>
    <manufacturer>bootleg (Nuova Videotron / Gamepack)</manufacturer>
    <category>Shooter</category>

    <setname>froggerv</setname>
    <parent>frogger</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,01,FF">
        <dip name="Unknown" bits="14" ids="Off,On"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="16,17" ids="3,5,7,256 (Cheat)"/>
        <dip name="Coinage" bits="18,19" ids="A 2/1 B 2/1,A 2/1 B 1/3,A 1/1 B 1/1,A 1/1 B 1/6" values="1,2,0,3"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="froggerv.zip|frogger.zip">
        <part crc="ed39f6d8" name="rana_ic4.ic4"/>
        <part crc="f8313d5d" name="rana_ic3.ic3"/>
        <part repeat="0xC000">00</part>
        <part crc="a1199087" name="rana_ic11.ic11"/>
        <part repeat="0x1800">00</part>
        <part crc="c1690dfc" name="rana_ic12.ic12"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="ic10"/>
        <part repeat="0xE0">00</part>
        <part crc="4ac17114" name="ic7"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 02 80 00 00 00 00 00 00 00 00 00 20 00
            11 12 03 04 01 00 0A 02 13 14 0B 0C 09 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 83 F1 00 0A 42 01
            00 00 83 EF 00 02 42 04
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="12"></nvram>

    <remark>Frogger (Nuova Videotron Bootleg) (Nuova Videotron / Gamepack Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
