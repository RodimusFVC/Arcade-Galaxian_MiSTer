<misterromdescription>
    <name>Quaak (Bootleg Of Frogger)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Frogger</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>quaak</setname>
    <parent>frogger</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FC,F1,00">
        <dip name="Lives" bits="8,9" ids="3,5,7,256 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="A 2/1 B 2/1 C 2/1,A 2/1 B 1/3 C 2/1,A 1/1 B 1/1 C 1/1,A 1/1 B 1/6 C 1/1" values="1,2,0,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="quaak.zip|frogger.zip">
        <part crc="5d0e2716" name="1f.bin"/>
        <part crc="cfbf8219" name="2f.bin"/>
        <part crc="cbb17731" name="3f.bin"/>
        <part crc="817ff82d" name="4f.bin"/>
        <part crc="5a8dd54b" name="5f.bin"/>
        <part crc="e1d46369" name="6f.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="28350f17" name="7h.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="e080f942" name="8h.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="a35ec965" name="n82s123.bin"/>
        <part repeat="0x3FE0">00</part>
        <part crc="b4c2180e" name="a.bin"/>
        <part crc="a1aae0bc" name="b.bin"/>
        <part crc="9d88fd0a" name="c.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 91 00 04 80 00 02 00 04 00 06 23 00 00 00 00
            09 00 16 00 04 03 12 11 00 00 00 00 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 83 F1 00 0A 63 01
            00 00 83 EF 00 02 63 04
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="12"></nvram>

    <remark>Quaak (Bootleg Of Frogger)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
