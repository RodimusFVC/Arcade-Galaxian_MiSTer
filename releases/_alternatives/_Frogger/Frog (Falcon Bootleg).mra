<misterromdescription>
    <name>Frog (Falcon Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Frogger</series>
    <year>1981</year>
    <manufacturer>bootleg (Falcon)</manufacturer>
    <category>Shooter</category>

    <setname>frogf</setname>
    <parent>frogger</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FC,F1,00">
        <dip name="Lives" bits="8,9" ids="3,5,7,256 (Cheat)"/>
        <dip name="Coinage" bits="17,18" ids="A 2/1 B 2/1 C 2/1,A 2/1 B 1/3 C 2/1,A 1/1 B 1/1 C 1/1,A 1/1 B 1/6 C 1/1" values="1,2,0,3"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="frogf.zip|frogger.zip">
        <part crc="8ff0a973" name="6.bin"/>
        <part crc="3087bb4b" name="7.bin"/>
        <part crc="c3869d12" name="8.bin"/>
        <part repeat="0xD000">00</part>
        <part crc="05f7d883" name="frogger.607"/>
        <part repeat="0x1800">00</part>
        <part crc="658745f8" name="epr-1036.1k"/>
        <part repeat="0x1800">00</part>
        <part crc="413703bf" name="pr-91.6l"/>
        <part repeat="0x3FE0">00</part>
        <part crc="e8ab0256" name="frogger.608"/>
        <part crc="7380a48f" name="frogger.609"/>
        <part crc="31d7eb27" name="frogger.610"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            09 91 00 04 00 00 02 00 04 00 06 05 00 00 00 00
            09 00 16 00 04 03 12 11 00 00 00 00 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 25 1F 62 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 83 F0 00 0C 04 05
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="12"></nvram>

    <remark>Frog (Falcon Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
