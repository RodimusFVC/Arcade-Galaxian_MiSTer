<misterromdescription>
    <name>Tuono Blu (Bootleg Of Rescue)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Rescue</series>
    <year>1982</year>
    <manufacturer>bootleg (Videl Games)</manufacturer>
    <category>Shooter</category>

    <setname>rescueb</setname>
    <parent>rescue</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin joysticks (right stick = fire directions)</special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire Up,Fire Down,Fire Left,Fire Right,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,F3,FF">
        <dip name="Starting Level" bits="1" ids="1,3" values="1,0"/>
        <dip name="Lives" bits="8" ids="3,5" values="1,0"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="15" ids="Off,On" values="1,0"/>
        <dip name="Coinage" bits="17,18" ids="1C/1C,Coin A 1/2 Coin B 2/1,Coin A 1/3 Coin B 3/1,Coin A 1/4 Coin B 4/1" values="1,0,2,3"/>
        <dip name="Difficulty" bits="19" ids="Easy,Hard"/>
        <dip name="Unknown" bits="20" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="21" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="23" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="rescueb.zip|rescue.zip">
        <part crc="d3661258" name="p1.2c"/>
        <part crc="47464506" name="p2.2e"/>
        <part crc="7dc03ec3" name="p3.2f"/>
        <part crc="a11eaf78" name="p4.2h"/>
        <part crc="604df3a4" name="rb15ecpu.bin"/>
        <part repeat="0xB000">00</part>
        <part crc="4489d20c" name="rb15fcpu.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="5512c547" name="rb15hcpu.bin"/>
        <part repeat="0x1800">00</part>
        <part crc="40c6bcbd" name="rescue.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="8b24bf17" name="rb15csnd.bin"/>
        <part crc="d96e4fb3" name="rb15dsnd.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 98 01 00 80 00 02 00 00 00 20 03 15 02 00 00
            05 00 01 02 04 03 12 11 00 00 05 06 08 07 00 00
            13 00 00 00 00 00 14 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Tuono Blu (Bootleg Of Rescue) (Videl Games Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
