<misterromdescription>
    <name>Pac-Man (Bootleg On Galaxian Hardware, Set 1)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pac-Man</series>
    <year>1981</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>pacmanbl</setname>
    <parent>puckman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Difficulty" bits="17" ids="Easy,Hard"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="15000,20000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="pacmanbl.zip|puckman.zip">
        <part crc="6718df42" name="1"/>
        <part crc="33be3648" name="2"/>
        <part crc="f98c0ceb" name="3"/>
        <part crc="a9cd0082" name="4"/>
        <part crc="6d475afc" name="5"/>
        <part crc="cbe863d3" name="6"/>
        <part crc="7daef758" name="7"/>
        <part repeat="0xC800">00</part>
        <part crc="b2ed320b" name="12"/>
        <part repeat="0x800">00</part>
        <part crc="44a45b72" name="10"/>
        <part repeat="0x800">00</part>
        <part crc="ab88b2c4" name="11"/>
        <part repeat="0x800">00</part>
        <part crc="fa84659f" name="9"/>
        <part repeat="0x800">00</part>
        <part crc="24652bc4" name="sn74s288n.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 11 00 00 00 08 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 00 02 09 01 13 14 0B 0C 00 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 62 FE 5A 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 88 00 03 00 00
            00 00 51 80 00 01 40 40
            00 00 51 A0 00 01 40 40
            00 00 51 C0 00 01 40 40
            00 00 51 E0 00 01 40 40
            00 00 52 00 00 01 40 40
            00 00 52 20 00 01 40 40
            00 00 52 40 00 01 48 48
            00 00 52 60 00 01 47 47
            00 00 52 80 00 01 49 49
            00 00 52 A0 00 01 48 48
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="13"></nvram>

    <remark>Pac-Man (Bootleg On Galaxian Hardware, Set 1)</remark>
