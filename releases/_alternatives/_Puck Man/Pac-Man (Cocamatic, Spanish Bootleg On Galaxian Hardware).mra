<misterromdescription>
    <name>Pac-Man (Cocamatic, Spanish Bootleg On Galaxian Hardware)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pac-Man</series>
    <year>1981</year>
    <manufacturer>bootleg (Cocamatic)</manufacturer>
    <category>Shooter</category>

    <setname>pacmanblco</setname>
    <parent>puckman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Difficulty" bits="17" ids="Easy,Hard"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="15000,20000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="pacmanblco.zip|puckman.zip">
        <part crc="6718df42" name="co01.bin"/>
        <part crc="3954e41c" name="co02.bin"/>
        <part crc="f98c0ceb" name="co03.bin"/>
        <part crc="a9cd0082" name="co04.bin"/>
        <part crc="6d475afc" name="co05.bin"/>
        <part crc="cbe863d3" name="co06.bin"/>
        <part crc="9b6ee47a" name="co07.bin"/>
        <part repeat="0xC800">00</part>
        <part crc="b2ed320b" name="co10.bin"/>
        <part repeat="0x800">00</part>
        <part crc="44a45b72" name="co11.bin"/>
        <part repeat="0x800">00</part>
        <part crc="ab88b2c4" name="co09.bin"/>
        <part repeat="0x800">00</part>
        <part crc="fa84659f" name="co12.bin"/>
        <part repeat="0x800">00</part>
        <part crc="6a0c7d87" name="cocamatic_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 11 00 00 00 08 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 00 02 09 01 13 14 0B 0C 00 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <remark>Pac-Man (Cocamatic, Spanish Bootleg On Galaxian Hardware) (Cocamatic Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
