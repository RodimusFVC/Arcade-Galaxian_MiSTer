        <part crc="f2d8c01e" name="moon_4l.bin" offset="0x800" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="f2d8c01e" name="moon_4l.bin" offset="0x0" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="346a1720" name="moon_h5.bin" offset="0x800" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="346a1720" name="moon_h5.bin" offset="0x0" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="4e3caeab" name="mb7051.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 91 00 00 00 08 00 00 00 00 00 00 00 00 00 00
