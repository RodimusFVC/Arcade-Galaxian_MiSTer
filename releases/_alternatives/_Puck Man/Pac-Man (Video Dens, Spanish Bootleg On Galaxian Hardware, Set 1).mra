<misterromdescription>
    <name>Pac-Man (Video Dens, Spanish Bootleg On Galaxian Hardware, Set 1)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pac-Man</series>
    <year>1981</year>
    <manufacturer>bootleg (Video Dens)</manufacturer>
    <category>Shooter</category>

    <setname>pacmanblv</setname>
    <parent>puckman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Difficulty" bits="17" ids="Easy,Hard"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="15000,20000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="pacmanblv.zip|puckman.zip">
        <part crc="590de3f3" name="pacvideodens-1-2516.bin"/>
        <part crc="3954e41c" name="pacvideodens-2-2516.bin"/>
        <part crc="f98c0ceb" name="pacvideodens-3-2516.bin"/>
        <part crc="a9cd0082" name="pacvideodens-4-2516.bin"/>
        <part crc="42f08538" name="pacvideodens-9-2516.bin"/>
        <part crc="7aa90d69" name="pacvideodens-10-2516.bin"/>
        <part crc="2bbed46e" name="pacvideodens-11-2716.bin"/>
        <part repeat="0xC800">00</part>
        <part crc="b2ed320b" name="pacvideodens-15-2716.bin"/>
        <part repeat="0x800">00</part>
        <part crc="44a45b72" name="pacvideodens-17-2716.bin"/>
        <part repeat="0x800">00</part>
        <part crc="ab88b2c4" name="pacvideodens-14-2716.bin"/>
        <part repeat="0x800">00</part>
        <part crc="fa84659f" name="pacvideodens-16-2716.bin"/>
        <part repeat="0x800">00</part>
        <part crc="c3ac9467" name="pacvideodens-im5610cpe.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 11 00 00 00 08 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 00 02 09 01 13 14 0B 0C 00 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
