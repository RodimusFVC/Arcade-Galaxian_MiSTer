        <part crc="2bbed46e" name="pac-7-2716.bin"/>
        <part repeat="0xC800">00</part>
        <part crc="f2d8c01e" name="1-2732.hj" offset="0x800" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="f2d8c01e" name="1-2732.hj" offset="0x0" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="346a1720" name="2732.kl" offset="0x800" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="346a1720" name="2732.kl" offset="0x0" length="0x800"/>
        <part repeat="0x800">00</part>
        <part crc="6a0c7d87" name="82s123.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
