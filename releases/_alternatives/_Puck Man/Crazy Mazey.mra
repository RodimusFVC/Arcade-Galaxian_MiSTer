<misterromdescription>
    <name>Crazy Mazey</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Crazy Mazey</series>
    <year>1982</year>
    <manufacturer>bootleg (Game-A-Tron)</manufacturer>
    <category>Shooter</category>

    <setname>crazym</setname>
    <parent>puckman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,C0,00,FF">
        <dip name="Coin A" bits="14" ids="2C/1C,1C/1C"/>
        <dip name="Coin B" bits="15" ids="1C/3C,1C/5C" values="1,0"/>
        <dip name="Difficulty" bits="17" ids="Easy,Hard"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="16" ids="15000,20000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="crazym.zip|puckman.zip">
        <part crc="d1f2e906" name="cm.7f" offset="0x0" length="0x800"/>
        <part crc="27aeff15" name="cm.7h" offset="0x0" length="0x800"/>
        <part crc="0ae404f3" name="cm.7k" offset="0x0" length="0x800"/>
        <part crc="f553eca3" name="cm.7m" offset="0x0" length="0x800"/>
        <part crc="d1f2e906" name="cm.7f" offset="0x800" length="0x800"/>
        <part crc="27aeff15" name="cm.7h" offset="0x800" length="0x800"/>
        <part crc="0ae404f3" name="cm.7k" offset="0x800" length="0x800"/>
        <part crc="f553eca3" name="cm.7m" offset="0x800" length="0x800"/>
        <part repeat="0xC000">00</part>
        <part crc="5b347525" name="cm.1h"/>
        <part repeat="0x1000">00</part>
        <part crc="30203318" name="cm.1k"/>
        <part repeat="0x1000">00</part>
        <part crc="fbb00a71" name="cm.6l"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 91 00 00 00 04 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 01 00 0A 02 13 14 0B 0C 09 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 04
        </part>
    </rom>

    <remark>Crazy Mazey (Game-A-Tron Bootleg)</remark>
