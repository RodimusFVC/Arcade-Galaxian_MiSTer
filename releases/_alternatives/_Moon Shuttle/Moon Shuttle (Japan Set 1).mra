<misterromdescription>
    <name>Moon Shuttle (Japan Set 1)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Shuttle</series>
    <year>1981</year>
    <manufacturer>Nichibutsu</manufacturer>
    <category>Shooter</category>

    <setname>mshuttlej</setname>
    <parent>mshuttle</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="03,80,00,FF">
        <dip name="Service Mode" bits="14" ids="Off,On"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="18" ids="20000,30000"/>
        <dip name="Coin A" bits="19,20" ids="4C/1C,3C/1C,2C/1C,1C/1C" values="3,2,1,0"/>
        <dip name="Coin B" bits="21,22" ids="1C/1C,1C/2C,1C/3C,1C/4C"/>
        <dip name="Unknown" bits="23" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mshuttlej.zip|mshuttle.zip">
        <part crc="a5a292b4" name="mcs.5"/>
        <part crc="acdc0f9e" name="mcs.4"/>
        <part crc="c1e3f5d8" name="mcs.3"/>
        <part crc="14577703" name="mcs.2"/>
        <part crc="27d46772" name="mcs.1"/>
        <part repeat="0xB000">00</part>
        <part crc="3601b380" name="my09"/>
        <part crc="b659e932" name="my11"/>
        <part repeat="0x800">00</part>
        <part crc="992b06cd" name="my08"/>
        <part crc="d860e6ce" name="my10"/>
        <part repeat="0x800">00</part>
        <part crc="ea0d1af0" name="mscprom1.bin"/>
        <part repeat="0x7FE0">00</part>
        <part crc="522a2920" name="my07"/>
        <part crc="6d2dd711" name="my06"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 00 00 00 80 0B 02 00 00 00 00 00 00 00 00 00
            11 12 01 02 05 04 00 00 13 14 09 0A 0D 0C 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            10 10 80 18
        </part>
    </rom>

    <remark>Moon Shuttle (Japan Set 1) (Nichibutsu)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
