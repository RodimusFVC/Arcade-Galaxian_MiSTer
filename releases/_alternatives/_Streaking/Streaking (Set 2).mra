<misterromdescription>
    <name>Streaking (Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Streaking</series>
    <year>1980</year>
    <manufacturer>Shoei</manufacturer>
    <category>Shooter</category>

    <setname>streaknga</setname>
    <parent>streakng</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,40,06,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="14,15" ids="10000,15000,20000,None" values="1,2,3,0"/>
        <dip name="Coinage" bits="16,17" ids="2C/1C,1C/1C,1C/2C,Free Play" values="0,2,1,3"/>
        <dip name="Lives" bits="18,19" ids="1,2,3,5" values="3,2,1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="streaknga.zip|streakng.zip">
        <part crc="c827e124" name="st1.bin"/>
        <part crc="b01d4f8f" name="st2.bin"/>
        <part crc="c7a9c493" name="st3.bin"/>
        <part crc="12487c75" name="st4.bin"/>
        <part crc="f9f9e2be" name="5st.bin"/>
        <part crc="c22fe6c2" name="6st.bin"/>
        <part crc="9cd7869a" name="7st.bin"/>
        <part crc="5e750ad3" name="8st.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="cddd8924" name="11.bin"/>
        <part repeat="0x800">00</part>
        <part crc="6a2a8a0f" name="9.bin"/>
        <part repeat="0x800">00</part>
        <part crc="10cda095" name="12.bin"/>
        <part repeat="0x800">00</part>
        <part crc="3563dfbe" name="10.bin"/>
        <part repeat="0x800">00</part>
        <part crc="bce79607" name="sk.bpr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 91 00 00 00 08 00 00 00 00 00 00 00 00 00 00
            11 09 03 04 00 00 02 01 13 14 0B 0C 00 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 88 00 03 00 00
            00 00 51 80 00 01 40 40
            00 00 51 A0 00 01 40 40
            00 00 51 C0 00 01 40 40
            00 00 51 E0 00 01 40 40
