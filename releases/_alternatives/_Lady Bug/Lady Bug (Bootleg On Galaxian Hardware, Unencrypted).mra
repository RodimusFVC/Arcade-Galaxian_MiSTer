<misterromdescription>
    <name>Lady Bug (Bootleg On Galaxian Hardware, Unencrypted)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Lady Bug</series>
    <year>1983</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>ladybugg</setname>
    <parent>ladybug</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Difficulty" bits="16,17" ids="Easy,Medium,Hard,Hardest"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="ladybugg.zip|ladybug.zip">
        <part crc="e67e241d" name="lbuggx.1"/>
        <part crc="3cb1fb9a" name="lbuggx.2"/>
        <part crc="0937009e" name="lbuggx.3"/>
        <part crc="3e773f62" name="lbuggx.4"/>
        <part crc="2b0d42e5" name="lbuggx.5"/>
        <part crc="159f9433" name="lbuggx.6"/>
        <part crc="f2be06d5" name="lbuggx.7"/>
        <part crc="646fe79f" name="lbuggx.8"/>
        <part repeat="0xC800">00</part>
        <part crc="7efb9dc5" name="lbuggx.a"/>
        <part repeat="0x1800">00</part>
        <part crc="351d4ddc" name="lbuggx.b"/>
        <part repeat="0x1000">00</part>
        <part crc="4e3caeab" name="lbuggx.clr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 11 00 20 00 05 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 00 02 09 01 13 14 0B 0C 00 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 58 84 00 64 01 47
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="100"></nvram>

    <remark>Lady Bug (Bootleg On Galaxian Hardware, Unencrypted)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
