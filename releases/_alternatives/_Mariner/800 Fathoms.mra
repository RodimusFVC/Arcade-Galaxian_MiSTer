<misterromdescription>
    <name>800 Fathoms</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mariner</series>
    <year>1981</year>
    <manufacturer>Amenip (US Billiards Inc. license)</manufacturer>
    <category>Shooter</category>

    <setname>800fath</setname>
    <parent>mariner</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F1,FF">
        <dip name="Lives" bits="8,9" ids="3,4,5,Free Play"/>
        <dip name="Coinage" bits="17,18" ids="1C/1C,1C/2C,1C/3C,1C/4C"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="800fath.zip|mariner.zip">
        <part crc="5dd3d42f" name="tu1.2h"/>
        <part crc="efe7ca28" name="tm2.2k"/>
        <part crc="027881a6" name="tm3.2l"/>
        <part crc="a0fde7dc" name="tm4.2m"/>
        <part repeat="0x1800">00</part>
        <part crc="f864a8a6" name="tu5.2p" offset="0x800" length="0x800"/>
        <part crc="f864a8a6" name="tu5.2p" offset="0x0" length="0x800"/>
        <part repeat="0x9800">00</part>
        <part crc="70ae611f" name="tm8.5f"/>
        <part repeat="0x1000">00</part>
        <part crc="8e4e999e" name="tm9.5h"/>
        <part repeat="0x1000">00</part>
        <part crc="ca42b6dd" name="t4.6e"/>
        <part repeat="0xE0">00</part>
        <part crc="ad208ccc" name="t6.6p" offset="0x0" length="0x40"/>
        <part crc="1bd88cff" name="t5.7p"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            11 90 01 00 00 00 02 00 00 00 00 00 40 00 08 C0
            09 06 16 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 62 FE 5A 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 00 00 1E 00 01
            00 00 40 A8 00 03 00 01
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="33"></nvram>

    <remark>800 Fathoms (Amenip (US Billiards Inc. License))</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
