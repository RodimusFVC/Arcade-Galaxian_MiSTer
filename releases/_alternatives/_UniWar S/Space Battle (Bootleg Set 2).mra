<misterromdescription>
    <name>Space Battle (Bootleg Set 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>UniWar S</series>
    <year>1980</year>
    <manufacturer>bootleg</manufacturer>
    <category>Shooter</category>

    <setname>spacbat2</setname>
    <parent>uniwars</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,00,01">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/6C,A 1C/2C  B 1C/6C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="4000,5000,7000,None" values="1,2,3,0"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="spacbat2.zip|uniwars.zip">
