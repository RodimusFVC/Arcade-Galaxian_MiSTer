        <part>
            00 90 00 00 00 40 01 FF FF FF 00 01 02 80 80 80
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 20 00 03 00 00 00 00 00 00 00 00 00 00 00 00
