<misterromdescription>
    <name>Pajaro Del Espacio (Spanish Bootleg Of UniWar S)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>UniWar S</series>
    <year>1980</year>
    <manufacturer>bootleg (PSV S.A.)</manufacturer>
    <category>Shooter</category>

    <setname>pajaroes</setname>
    <parent>uniwars</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,Select,Start,R,L"/>

    <switches default="00,40,01">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="1C/1C,1C/2C; 1C/1C,1C/4C; 1C/2C,Free Play (corrupt text)" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="None,4000,5000,7000"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="pajaroes.zip|uniwars.zip">
        <part crc="82a9da91" name="pea.rom"/>
        <part crc="cc59b49c" name="peb.rom"/>
        <part crc="3bc5a165" name="pec.rom"/>
        <part crc="c50149d0" name="ped.rom"/>
