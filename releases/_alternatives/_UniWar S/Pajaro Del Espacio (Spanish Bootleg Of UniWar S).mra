        <part crc="797d45c7" name="pe02.rom"/>
        <part repeat="0xC000">00</part>
        <part crc="012941e0" name="pe07.rom"/>
        <part crc="c26132af" name="pe09.rom"/>
        <part repeat="0x1000">00</part>
        <part crc="fc8b58fd" name="pe06.rom"/>
        <part crc="dcc2b33b" name="pe08.rom"/>
        <part repeat="0x1000">00</part>
        <part crc="25c79518" name="uniwars.clr"/>
    </rom>

    <!-- Index 1: Config -->
