<misterromdescription>
    <name>Gingateikoku No Gyakushu</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>UniWar S</series>
    <year>1980</year>
    <manufacturer>Irem</manufacturer>
    <category>Shooter</category>

    <setname>gteikoku</setname>
    <parent>uniwars</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,01,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="None,4000,5000,7000"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="gteikoku.zip|uniwars.zip">
        <part crc="d975af10" name="f07_1a.bin"/>
        <part crc="b2ed14c3" name="h07_2a.bin"/>
        <part crc="945f4160" name="k07_3a.bin"/>
        <part crc="ddc80bc5" name="m07_4a.bin"/>
        <part crc="62354351" name="d08p_5a.bin"/>
        <part crc="d915a389" name="e08p_6a.bin"/>
        <part crc="c9245346" name="m08p_7a.bin"/>
        <part crc="797d45c7" name="n08p_8a.bin"/>
        <part repeat="0xC000">00</part>
        <part crc="8313c959" name="h01_1.bin"/>
        <part crc="c26132af" name="h01_2.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="c9d4537e" name="k01_1.bin"/>
        <part crc="dcc2b33b" name="k01_2.bin"/>
        <part repeat="0x1000">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 00 20 00 03 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            06 7A 24 69 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 A8 00 03 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="3"></nvram>

    <remark>Gingateikoku No Gyakushu (Irem)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
