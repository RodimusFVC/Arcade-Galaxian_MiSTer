<misterromdescription>
    <name>Galactica-2 (Bootleg Of Moon Alien Part 2)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Moon Alien Part 2</series>
    <year>1980</year>
    <manufacturer>bootleg (Cirsa)</manufacturer>
    <category>Shooter</category>

    <setname>galactica2</setname>
    <parent>moonal2</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14,15" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life" bits="16,17" ids="4000,5000,7000,None" values="1,2,3,0"/>
        <dip name="Lives" bits="18" ids="3,5"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="galactica2.zip|moonal2.zip">
        <part crc="c561235e" name="a_2_galactica_cirsa"/>
        <part crc="0b3c3cae" name="b_2_galactica_cirsa"/>
        <part crc="b2170d3b" name="c_2_galactica_cirsa"/>
        <part crc="51c95126" name="f_2_galactica_cirsa"/>
        <part crc="16b9d56d" name="g_2_galactica_cirsa"/>
        <part repeat="0xD000">00</part>
        <part crc="6babd14e" name="h_2_galactica_cirsa" offset="0x0" length="0x800"/>
        <part crc="6babd14e" name="h_2_galactica_cirsa" offset="0x0" length="0x800"/>
        <part repeat="0x1000">00</part>
        <part crc="0997e81b" name="i_2_galactica_cirsa" offset="0x0" length="0x800"/>
        <part crc="0997e81b" name="i_2_galactica_cirsa" offset="0x0" length="0x800"/>
        <part repeat="0x1000">00</part>
        <part crc="c3ac9467" name="74s288n"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 41 00 00 00 00 00 00 00 00 00 00 00 00
            11 12 03 04 05 00 00 16 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Galactica-2 (Bootleg Of Moon Alien Part 2) (Cirsa Bootleg)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
