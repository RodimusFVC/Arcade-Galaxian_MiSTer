<misterromdescription>
    <name>Super Cobra (Stern Electronics) (Encrypted, KONATEC XC-103SS CPU)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Super Cobra</series>
    <year>1981</year>
    <manufacturer>Konami (Stern Electronics license)</manufacturer>
    <category>Shooter</category>

    <setname>scobrae</setname>
    <parent>scobra</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="FF,FD,F3,00">
        <dip name="Allow Continue" bits="8" ids="No,255 Times"/>
        <dip name="Lives" bits="9" ids="3,5"/>
        <dip name="Coinage" bits="17,18" ids="2C/1C,4C/3C,1C/1C,99 Credits" values="2,3,1,0"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="scobrae.zip|scobra.zip">
        <part crc="ba9d4152" name="super cobra ra1 2c 1981.2c"/>
        <part crc="f9b77b27" name="super cobra ra1 2e 1981.2e"/>
        <part crc="e6109c2c" name="super cobra ra1 2f 1981.2f"/>
        <part crc="8762735b" name="super cobra ra1 2h 1981.2h"/>
        <part crc="5648f404" name="super cobra ra1 2j 1981.2j"/>
        <part crc="34476cc3" name="super cobra ra1 2l 1981.2l"/>
        <part repeat="0xA000">00</part>
        <part crc="64d113b4" name="super cobra ra1 5f 1981.5f"/>
        <part repeat="0x1800">00</part>
        <part crc="a96316d3" name="super cobra ra1 5h 1981.5h"/>
        <part repeat="0x1800">00</part>
        <part crc="fd35c561" name="ss1.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="deeb0dd3" name="super cobra ra1 5c 1981.5c"/>
        <part crc="872c1a74" name="super cobra ra1 5d 1981.5d"/>
        <part crc="ccd7a110" name="super cobra ra1 5e 1981.5e"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            07 90 01 00 80 00 02 00 00 00 30 03 00 00 00 00
            09 06 16 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            01 00 00
        </part>
    </rom>

    <remark>Super Cobra (Stern Electronics) (Encrypted, KONATEC XC-103SS CPU) (Konami (Stern Electronics License))</remark>
