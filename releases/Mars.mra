<misterromdescription>
    <name>Mars</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mars</series>
    <year>1981</year>
    <manufacturer>Artic</manufacturer>
    <category>Shooter</category>

    <setname>mars</setname>
    <parent>mars</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin joysticks (right stick = fire directions)</special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire Up,Fire Down,Fire Left,Fire Right,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FC,F9,FF">
        <dip name="Coin B" bits="8" ids="1C/3C,1C/5C"/>
        <dip name="Coin A" bits="9" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Cabinet" bits="17" ids="Upright,Cocktail"/>
        <dip name="Unknown" bits="18" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="19" ids="3,255 (Cheat)" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="mars.zip">
        <part crc="2f88892c" name="u26.3"/>
        <part crc="9e6bcbf7" name="u56.4"/>
        <part crc="df496e6e" name="u69.5"/>
        <part crc="75f274bb" name="u98.6"/>
        <part crc="497fd8d0" name="u114.7"/>
        <part crc="3d4cd59f" name="u133.8"/>
        <part repeat="0xD000">00</part>
        <part crc="279789d0" name="u72.1"/>
        <part repeat="0x1800">00</part>
        <part crc="c5dc627f" name="u101.2"/>
        <part repeat="0x1800">00</part>
        <part crc="4e3caeab" name="c01s.6e"/>
        <part repeat="0x3FE0">00</part>
        <part crc="bb5968b9" name="u39.9"/>
        <part crc="75fd7720" name="u51.10"/>
        <part crc="72a492da" name="u78.11"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            0F 98 01 00 00 00 02 00 00 00 20 03 00 00 04 01
            09 16 08 07 04 03 12 11 00 00 10 0F 0C 0B 14 13
            0A 00 00 00 01 06 02 05 00 00 00 00 00 0E 00 0D
