<misterromdescription>
    <name>Azurian Attack</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Azurian Attack</series>
    <year>1982</year>
    <manufacturer>Rait Electronics Ltd</manufacturer>
    <category>Shooter</category>

    <setname>azurian</setname>
    <parent>azurian</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,FD">
        <dip name="Lives" bits="15" ids="3,5"/>
        <dip name="Coinage" bits="16" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Bonus Life" bits="17" ids="5000,7000"/>
        <dip name="Cabinet" bits="19" ids="Upright,Cocktail"/>
        <dip name="Difficulty" bits="24,25" ids="Easy,Normal,Hard,Very Hard" values="3,1,2,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="azurian.zip">
        <part crc="17a0fca7" name="pgm.1"/>
        <part crc="14659848" name="pgm.2"/>
        <part crc="8f60fb97" name="pgm.3"/>
        <part repeat="0xD000">00</part>
        <part crc="f5afb803" name="gfx.1"/>
        <part repeat="0x1800">00</part>
        <part crc="ae96e5d1" name="gfx.2"/>
        <part repeat="0x1800">00</part>
        <part crc="6a0c7d87" name="l06_prom.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            00 90 01 00 00 00 00 00 00 00 00 00 00 00 00 00
            02 01 04 03 11 05 0D 00 13 14 0A 09 0C 0B 28 00
            00 00 29 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 40 B3 00 03 00 00
            00 00 40 B4 00 01 50 50
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="4"></nvram>

    <remark>Azurian Attack (Rait Electronics Ltd)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
