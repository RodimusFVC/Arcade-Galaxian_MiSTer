        <part crc="a90ac60a" name="f.2j"/>
        <part crc="b7caf17f" name="g.3j"/>
        <part crc="d88f86cc" name="4764.4k" offset="0x0" length="0x800"/>
        <part crc="1f8841d2" name="h.5j"/>
        <part crc="b24a7a88" name="i.1h"/>
        <part repeat="0xA800">00</part>
        <part crc="df47d042" name="b.15j"/>
        <part crc="5f08bd01" name="d.14j"/>
        <part crc="ac234ff4" name="f.13j"/>
