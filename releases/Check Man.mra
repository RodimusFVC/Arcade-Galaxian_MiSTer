<misterromdescription>
    <name>Check Man</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Check Man</series>
    <year>1982</year>
    <manufacturer>Zilec-Zenitone</manufacturer>
    <category>Shooter</category>

    <setname>checkman</setname>
    <parent>checkman</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="00,00,00,FF">
        <dip name="Coinage" bits="14" ids="A 2C/1C  B 1C/3C,A 1C/1C  B 1C/6C" values="1,0"/>
        <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="18" ids="100000,200000"/>
        <dip name="Difficulty Increases At Level" bits="19" ids="3,5" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000, colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="checkman.zip">
        <part crc="e8cbdd28" name="cm1"/>
        <part crc="b8432d4d" name="cm2"/>
        <part crc="15a97f61" name="cm3"/>
        <part crc="8c12ecc0" name="cm4"/>
        <part crc="2352cfd6" name="cm5"/>
        <part repeat="0xD800">00</part>
        <part crc="8d1bcca0" name="cm11" offset="0x0" length="0x800"/>
        <part crc="8d1bcca0" name="cm11" offset="0x0" length="0x800"/>
        <part repeat="0x1000">00</part>
        <part crc="3cd5c751" name="cm9" offset="0x0" length="0x800"/>
        <part crc="3cd5c751" name="cm9" offset="0x0" length="0x800"/>
        <part repeat="0x1000">00</part>
        <part crc="57a45057" name="checkman.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="0b09a3e8" name="cm13"/>
        <part crc="47f043be" name="cm14"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 40 00 01 00 0D 00 00 00 00 00 00 00 00
            12 11 03 04 0E 02 09 01 13 14 0B 0C 0D 0A 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 18 BF 97 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 80 1C 00 48 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="72"></nvram>

    <remark>Check Man (Zilec-Zenitone)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
