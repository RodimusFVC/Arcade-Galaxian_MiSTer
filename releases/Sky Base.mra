<misterromdescription>
    <name>Sky Base</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Sky Base</series>
    <year>1982</year>
    <manufacturer>Omori Electric Co., Ltd.</manufacturer>
    <category>Shooter</category>

    <setname>skybase</setname>
    <parent>skybase</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way horizontal</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="20,00,00,FF">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="14,15" ids="1C/1C (2 to start),1C/1C,1C/2C,Free Play" values="2,0,1,3"/>
        <dip name="Lives" bits="16,17" ids="3,4,5,Infinite (Cheat)"/>
        <dip name="Bonus Life" bits="18,19" ids="10000,15000,20000,None"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="skybase.zip">
        <part crc="845b87a5" name="skybase.9a"/>
        <part crc="096785c2" name="skybase.8a"/>
        <part crc="d50c715b" name="skybase.7a"/>
        <part crc="f57edb27" name="skybase.6a"/>
        <part crc="50365d95" name="skybase.5a"/>
        <part crc="cbd6647f" name="skybase.4a"/>
        <part repeat="0xA000">00</part>
        <part crc="9b471686" name="skybase.7t"/>
        <part crc="1cf723da" name="skybase.8t"/>
        <part crc="fe02e72c" name="skybase.10t"/>
        <part crc="0871291f" name="skybase.9t"/>
        <part crc="6a0c7d87" name="82s123.bpr"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 63 60 03 00 00 00 00 00 00 00 00 00 00
            11 00 03 04 05 00 00 00 13 14 0B 0C 0D 00 00 00
            00 00 00 00 00 00 06 0E 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            01 D6 38 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 80 3A 00 36 00 00
            00 00 80 00 00 01 14 14
            00 00 91 A1 00 01 00 00
            00 00 91 C1 00 01 00 00
            00 00 91 E1 00 01 00 00
            00 00 92 01 00 01 05 05
            00 00 92 21 00 01 00 00
            00 00 92 41 00 01 00 00
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="61"></nvram>

    <remark>Sky Base (Omori Electric Co., Ltd.)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
