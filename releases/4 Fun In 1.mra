    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="00,00,00,00,00">
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="18" ids="3,5"/>
        <dip name="Bonus Life (GM PT3)" bits="24,25" ids="10000,15000,20000,None" values="1,2,3,0"/>
        <dip name="Coinage (GM PT3)" bits="26,27" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
        <dip name="Bonus Life (G PT5)" bits="28,29" ids="4000,5000,7000,None" values="1,2,3,0"/>
        <dip name="Coinage (G PT5)" bits="30,31" ids="2C/1C,1C/1C,Free Play" values="1,0,3"/>
        <dip name="Bonus Life (GC)" bits="32" ids="50000,80000"/>
        <dip name="Coinage (GC)" bits="33,34" ids="2C/1C,1C/1C,Free Play" values="1,0,3"/>
        <dip name="Allow Continue (S PT2)" bits="35" ids="No,Yes" values="1,0"/>
        <dip name="Unknown" bits="36" ids="Off,On"/>
        <dip name="Unknown" bits="37" ids="Off,On"/>
        <dip name="Coinage (S PT2)" bits="38,39" ids="2C/1C,1C/1C,1C/2C,Free Play" values="1,0,2,3"/>
    </switches>

