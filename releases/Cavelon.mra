<misterromdescription>
    <name>Cavelon</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Cavelon</series>
    <year>1983</year>
    <manufacturer>Jetsoft</manufacturer>
    <category>Shooter</category>

    <setname>cavelon</setname>
    <parent>cavelon</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FD,F3,FF">
        <dip name="Cabinet" bits="8" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage" bits="9" ids="A 1/1 B 1/6,A 2/1 B 1/3"/>
        <dip name="Lives" bits="17,18" ids="5,4,3,2" values="0,2,1,3"/>
        <dip name="Unknown" bits="19" ids="Off,On"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="cavelon.zip">
        <part crc="a3b353ac" name="2.bin"/>
        <part crc="3f62efd6" name="1.bin"/>
        <part crc="39d74e4e" name="3.bin"/>
        <part repeat="0xA000">00</part>
        <part crc="d44fcd6f" name="h.bin" offset="0x0" length="0x1000"/>
        <part crc="d44fcd6f" name="h.bin" offset="0x0" length="0x1000"/>
        <part crc="59bc7f9e" name="k.bin" offset="0x0" length="0x1000"/>
        <part crc="59bc7f9e" name="k.bin" offset="0x0" length="0x1000"/>
        <part crc="d133356b" name="cavelon.clr"/>
        <part repeat="0x3FE0">00</part>
        <part crc="f58dcf55" name="1c_snd.bin"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            06 90 01 00 00 06 02 00 00 00 20 03 00 00 04 20
            09 06 00 05 04 03 12 11 00 00 0E 0D 0C 0B 14 13
            0A 00 00 00 01 00 02 00 00 00 00 00 00 00 00 00
            00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            02 B4 F4 78 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 42 FF 00 04 00 00
            00 00 43 04 00 0D 00 15
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="17"></nvram>

    <remark>Cavelon (Jetsoft)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
