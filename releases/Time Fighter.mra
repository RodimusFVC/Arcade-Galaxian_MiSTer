<misterromdescription>
    <name>Time Fighter</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Time Fighter</series>
    <year>198?</year>
    <manufacturer>Taito do Brasil</manufacturer>
    <category>Shooter</category>

    <setname>timefgtr</setname>
    <parent>timefgtr</parent>
    <mameversion>0289</mameversion>
    <rbf>Galaxian</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used" default="A,Y,B,X,Select,Start,R,L"/>

    <switches default="40,00,03,FF">
        <dip name="255 Lives (Cheat)" bits="5" ids="Off,On"/>
        <dip name="Extended Bonus Life" bits="6" ids="Off,On"/>
        <dip name="Coinage" bits="14" ids="1C/1C,2C/1C"/>
        <dip name="Lives" bits="15" ids="3,5"/>
        <dip name="Unknown" bits="16" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="17" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="18,19" ids="10000 50000,20000 50000,10000 60000,20000 60000"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx planes 0x10000 / 0x12000 (sprite ROM in the upper halves), colour PROM 0x14000, sound CPU 0x18000 -->
    <rom index="0" md5="none" zip="timefgtr.zip|fantastc.zip">
        <part crc="ba8b3e70" name="tp01"/>
        <part crc="796158c0" name="tp02"/>
        <part crc="fe6a1c98" name="tp03"/>
        <part crc="eff73185" name="tp04"/>
        <part crc="85023e4a" name="tp05"/>
        <part crc="b6b8aaf9" name="tp06"/>
        <part repeat="0xA000">00</part>
        <part crc="5f57342c" name="tp07"/>
        <part crc="636fd772" name="tp09"/>
        <part crc="2dc3c48b" name="tp08"/>
        <part crc="b27b450c" name="tp10"/>
        <part crc="800f5718" name="prom-74g138"/>
    </rom>

    <!-- Index 1: memory map, flags, video flags, board flags, ROM top, code extension, board flags 2 and 3, video flags 2, board flags 4, input map (see Arcade-Galaxian.sv) -->
    <rom index="1">
        <part>
            01 90 00 03 80 04 02 00 0B 29 00 00 00 00 00 00
            00 11 03 04 05 00 00 01 13 14 00 00 00 02 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- Index 3: hiscore config (MAME hiscore.dat), index 4: saved scores -->
    <rom index="3" md5="none">
        <part>
            00 31 7F 2D 00 FF 00 02 00 02 00 01 11 11 00 00
            00 00 85 35 00 1B 00 00
            00 00 85 4D 00 01 10 10
        </part>
    </rom>
    <rom index="4"></rom>
    <nvram index="4" size="28"></nvram>

    <remark>Time Fighter (Time Pilot Conversion On Galaxian Hardware) (Taito Do Brasil)</remark>
    <mratimestamp>20260928000000</mratimestamp>
</misterromdescription>
